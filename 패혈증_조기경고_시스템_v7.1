function pushAuditEntry(entry) {
  if (fbReady && fbDb) {
    fbDb.ref(AUDIT_PATH).push(entry).catch(err => console.warn('Firebase 기록 실패', err));
  } else {
    // Firebase 연결 안 될 때는 이 브라우저 안에서만 남김
    auditLog.push(entry);
