.patient-name { font-weight: 700; font-size: 13px; }
.patient-info { font-size: 11px; color: var(--muted); margin-top: 4px; }
.badge { font-size: 10px; font-weight: 800; padding: 3px 6px; border-radius: 99px; color: #fff; }
.danger { background: var(--red); }
.warning { background: var(--amber); }
