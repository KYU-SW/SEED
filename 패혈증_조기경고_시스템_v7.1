.trend-up { color: var(--red); font-weight: 800; font-size: 10px; margin-left: 5px; }
.patient-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
.patient-head h2 { font-size: 17px; margin: 0 0 3px; }
.patient-head p { font-size: 12px; color: var(--muted); margin: 0; }
.score-wrap { display: grid; grid-template-columns: 1.1fr 1fr; gap: 14px; margin-top: 14px; }
.score-box { background: var(--soft); border-radius: 10px; padding: 20px; text-align: center; }
.score-label { font-size: 12px; color: var(--muted); font-weight: 700; }
.score-value { font-size: 60px; line-height: 1; font-weight: 800; margin: 8px 0; }
.score-change { font-size: 12px; font-weight: 800; }
.status-indicator { display: inline-block; margin-top: 8px; color: #fff; padding: 7px 11px; border-radius: 7px; font-size: 12px; font-weight: 800; }
.reason-box { border: 1px solid var(--line); border-radius: 10px; padding: 14px; }
.reason-box h4 { margin: 0 0 8px; font-size: 13px; }
.reason-list { margin: 0; padding-left: 18px; }
.reason-list li { margin: 7px 0; font-size: 12px; }
.vitals-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
.view-toggle { display: inline-flex; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--panel); }
.view-toggle button { border: none; background: transparent; color: var(--text); padding: 8px 11px; font-size: 12px; font-weight: 700; cursor: pointer; }
.view-toggle button + button { border-left: 1px solid var(--line); }
.view-toggle button.on { background: var(--blue); color: #fff; }
.view-count { font-size: 10px; margin-left: 4px; padding: 1px 6px; border-radius: 99px; background: var(--soft); color: var(--text); }
.view-toggle button.on .view-count { background: rgba(255,255,255,.25); color: #fff; }
.scope-note { display: none; margin: -4px 0 14px; padding: 9px 12px; border-radius: 8px; border: 1px solid var(--blue); background: color-mix(in srgb, var(--blue) 7%, var(--panel)); font-size: 12px; font-weight: 700; }
.scope-note.show { display: block; }
.my-empty { display: none; text-align: center; padding: 40px 20px; }
body.no-my-patients .my-empty { display: block; }
body.no-my-patients .tab-content { display: none !important; }
.safety-banner { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.chip { font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; border: 1px solid var(--line); background: var(--soft); color: var(--text); }
.chip-danger { border-color: var(--red); color: var(--red); background: color-mix(in srgb, var(--red) 8%, var(--panel)); }
.chip-purple { border-color: var(--purple); color: var(--purple); background: color-mix(in srgb, var(--purple) 8%, var(--panel)); }
.chip-amber { border-color: var(--amber); color: var(--text); background: color-mix(in srgb, var(--amber) 12%, var(--panel)); }
.bundle-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
.bundle-clock { text-align: right; }
.bundle-timer { font-size: 30px; font-weight: 800; font-variant-numeric: tabular-nums; line-height: 1; }
.bundle-timer-sub { font-size: 11px; color: var(--muted); margin-top: 4px; font-weight: 700; }
.bundle-bar { height: 8px; background: var(--soft); border: 1px solid var(--line); border-radius: 99px; overflow: hidden; margin: 12px 0 4px; }
.bundle-bar > div { height: 100%; background: var(--green); transition: width .5s; }
.bundle-items { display: grid; gap: 6px; margin-top: 10px; }
.b-item { display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 9px 10px; border-radius: 7px; background: var(--soft); border-left: 3px solid var(--amber); }
.b-item.done { border-left-color: var(--green); }
.b-item.na { border-left-color: var(--line); opacity: .7; }
.b-mark { font-weight: 800; text-align: center; font-size: 14px; }
.b-item.done .b-mark { color: var(--green); }
.b-label { font-size: 12px; font-weight: 700; }
.b-sub { font-size: 11px; color: var(--muted); margin-top: 2px; }
.b-sub.warn { color: var(--red); font-weight: 700; }
.b-act { display: flex; gap: 6px; align-items: center; justify-content: flex-end; flex-wrap: wrap; }
.b-act input { width: 82px; border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 6px; padding: 5px 6px; font-size: 11px; }
.b-stamp { font-size: 11px; color: var(--muted); text-align: right; line-height: 1.5; }
.b-late { color: var(--red); font-weight: 800; }
.bundle-warn { margin-top: 8px; font-size: 12px; font-weight: 700; color: var(--red); }
.bundle-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 10px; font-size: 11px; color: var(--muted); flex-wrap: wrap; }
.bundle-chip { font-size: 10px; font-weight: 800; margin-left: 5px; color: var(--amber); }
.bundle-chip.over { color: var(--red); }
.vital-card { background: var(--soft); border-radius: 8px; padding: 12px; text-align: center; border: 1px solid transparent; }
.vital-card.abnormal { border-color: var(--amber); }
.vital-label { font-size: 11px; color: var(--muted); font-weight: 700; }
.vital-value { font-size: 18px; font-weight: 800; margin-top: 5px; }
.vital-delta { font-size: 10px; font-weight: 700; margin-top: 2px; }
.vital-range { font-size: 9px; color: var(--muted); margin-top: 3px; }
.chart-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
.tab { border: 1px solid var(--line); background: var(--soft); color: var(--text); padding: 6px 9px; border-radius: 6px; font-size: 11px; cursor: pointer; }
.tab.active { background: var(--blue); color: white; border-color: var(--blue); }
.chart-wrap { height: 270px; border: 1px solid var(--line); border-radius: 8px; background: var(--soft); padding: 10px; position: relative; }
.chart-wrap svg { width: 100%; height: 100%; display: block; }
.chart-legend { display: flex; justify-content: space-between; font-size: 11px; color: var(--muted); margin-top: 8px; }
.guide { padding: 13px; border-radius: 9px; border: 1px solid var(--line); background: var(--soft); margin-top: 12px; }
.guide p { margin: 6px 0 0; font-size: 12px; }
.action-box { margin-top: 12px; padding: 13px; border-radius: 9px; border: 1px solid var(--line); background: var(--soft); border-left: 4px solid var(--line); }
.action-box.danger { border-left-color: var(--red); background: var(--soft); }
.action-box.warning { border-left-color: var(--amber); background: var(--soft); }
.action-box.success { border-left-color: var(--green); background: var(--soft); }
.action-box h4 { margin: 0 0 9px; font-size: 13px; }
.action-box ul { margin: 0; padding-left: 0; list-style: none; }
.action-box li { font-size: 12px; line-height: 1.6; padding-left: 20px; position: relative; margin: 5px 0; }
.action-box li::before { content: '✓'; position: absolute; left: 0; font-weight: 800; }
.action-box.danger li::before { color: var(--red); }
.action-box.warning li::before { color: var(--amber); }
.action-box.success li::before { color: var(--green); }
.shap-row { display: grid; grid-template-columns: 70px 1fr 42px; gap: 8px; align-items: center; margin: 9px 0; font-size: 11px; }
.bar-bg { height: 19px; background: var(--soft); border-radius: 5px; overflow: hidden; border: 1px solid var(--line); }
.bar-fill { height: 100%; background: var(--blue); }
.bar-fill.hot { background: var(--red); }
.shap-val { text-align: right; font-weight: 700; }
.side-section { margin-bottom: 18px; }
.mini-title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.mini-title h3 { margin: 0; }
.alarm-list { max-height: 320px; overflow-y: auto; }
.alarm { border-left: 4px solid var(--blue); background: var(--soft); border-radius: 6px; padding: 9px; margin-bottom: 7px; }
.alarm.danger-border { border-left-color: var(--red); }
.alarm.warning-border { border-left-color: var(--amber); }
.alarm-head { display: flex; justify-content: space-between; gap: 8px; font-size: 10px; color: var(--muted); }
.alarm-msg { font-size: 11px; margin: 5px 0 0; }
.feedback-group { display: flex; gap: 8px; }
.feedback-group input { flex: 1; border: 1px solid var(--line); background: var(--panel); color: var(--text); padding: 9px; border-radius: 7px; font-size: 12px; }
.feedback-bar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 10px; flex-wrap: wrap; }
.feedback-bar select { border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 7px; padding: 6px 8px; font-size: 11px; }
.feedback-list { max-height: 300px; overflow-y: auto; margin-top: 10px; }
.feedback-item { background: var(--soft); border-radius: 6px; border-left: 3px solid var(--line); padding: 10px; margin-top: 7px; font-size: 12px; display: flex; justify-content: space-between; gap: 10px; align-items: flex-start; }
.feedback-item.own { border-left-color: var(--green); }
.feedback-item.unread { border-left-color: var(--blue); background: color-mix(in srgb, var(--blue) 7%, var(--soft)); }
.feedback-meta { color: var(--muted); font-size: 10px; margin-bottom: 4px; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.author { font-weight: 800; color: var(--text); font-size: 11px; }
.role-tag { font-size: 9px; border: 1px solid var(--line); border-radius: 4px; padding: 1px 5px; color: var(--muted); }
.new-dot { font-size: 9px; font-weight: 800; color: #fff; background: var(--blue); border-radius: 99px; padding: 1px 6px; }
.count-badge { font-size: 10px; font-weight: 800; color: #fff; background: var(--blue); border-radius: 99px; padding: 2px 7px; }
.link-btn { background: none; border: none; color: var(--muted); cursor: pointer; font-size: 11px; padding: 0; }
.link-btn:hover { color: var(--red); }
.footer { margin-top: 18px; background: var(--soft); color: var(--muted); border: 1px solid var(--line); padding: 11px; border-radius: 8px; text-align: center; font-size: 11px; }
.empty { font-size: 12px; color: var(--muted); padding: 14px 4px; text-align: center; }
.table-container { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.data-table th { background: var(--soft); padding: 10px; text-align: left; border-bottom: 2px solid var(--line); font-weight: 700; }
.data-table td { padding: 10px; border-bottom: 1px solid var(--line); }
.data-table tbody tr:hover { background: var(--soft); }
.checklist { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
.checklist-item { display: flex; gap: 8px; align-items: center; }
.checklist-item input { width: 18px; height: 18px; cursor: pointer; }
.checklist-item label { cursor: pointer; font-size: 12px; flex: 1; }
.auto-tag { font-size: 9px; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 1px 4px; }
.message-box { background: var(--soft); border-left: 3px solid var(--blue); border-radius: 6px; padding: 10px; margin-bottom: 8px; font-size: 12px; }
.message-box.mine { border-left-color: var(--green); }
.message-header { display: flex; justify-content: space-between; margin-bottom: 4px; font-weight: 700; }
.message-time { font-size: 10px; color: var(--muted); }
.subcard { padding: 14px; background: var(--soft); border-radius: 8px; border: 1px solid var(--line); }
.stat-box { padding: 16px; background: var(--soft); border-radius: 8px; text-align: center; }
.stat-num { font-size: 48px; font-weight: 800; line-height: 1; }
.note { font-size: 11px; color: var(--muted); margin-top: 10px; }
.login-screen { display: flex; justify-content: center; align-items: center; min-height: 100vh; background: var(--bg); padding: 20px; }
.login-card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 36px 32px; max-width: 400px; width: 100%; box-shadow: 0 10px 30px rgba(0, 0, 0, .08); }
.login-title { text-align: center; font-size: 26px; margin: 0 0 6px; }
.login-sub { text-align: center; color: var(--muted); margin: 0 0 28px; font-size: 13px; }
.login-label { display: block; font-size: 12px; font-weight: 700; margin-bottom: 7px; }
.login-field { width: 100%; border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 8px; padding: 10px; font-size: 13px; margin-bottom: 18px; }
.login-error { color: var(--red); font-size: 12px; font-weight: 700; margin: -8px 0 12px; min-height: 16px; }
.login-submit { width: 100%; padding: 12px; font-size: 13px; }
.login-hint { margin-top: 20px; padding: 12px; background: var(--soft); border: 1px solid var(--line); border-radius: 8px; font-size: 11px; color: var(--muted); line-height: 1.7; }
@media (max-width: 1250px) { .main-grid { grid-template-columns: 220px 1fr; } .vitals-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 850px) { .b-item { grid-template-columns: 22px minmax(0, 1fr); } .b-act { grid-column: 2; justify-content: flex-start; } .main-grid { grid-template-columns: 1fr; } .vitals-grid { grid-template-columns: repeat(2, 1fr); } .header { flex-direction: column; } .score-wrap { grid-template-columns: 1fr; } }
@media print {
  .tab-nav, .header-actions, .toolbar, .btn { display: none !important; }
  .tab-content { display: block !important; }
  body { background: #fff; }
  .card { break-inside: avoid; box-shadow: none; }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>
</head>
<body>
<!-- 로그인 화면 -->
<div id="loginScreen" class="login-screen">
  <div class="login-card">
    <h1 class="login-title">🩺 바이탈 사인</h1>
    <p class="login-sub">패혈증 조기 경고 시스템 v5.5.0</p>

    <label class="login-label" for="doctorSelect">의료진 선택</label>
    <select id="doctorSelect" class="login-field" onkeydown="if(event.key==='Enter')loginUser()">
      <option value="">의료진을 선택하세요</option>
      <option value="심가원">심가원 (PM, 26615031)</option>
      <option value="이아연">이아연 (PM, 26615038)</option>
      <option value="하유진">하유진 (PM, 26615053)</option>
    </select>

