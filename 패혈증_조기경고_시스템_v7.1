.tab-btn.active:hover { background: var(--blue); }
.tab-content { display: none; }
.tab-content.active { display: block; }
.toolbar { display: flex; justify-content: space-between; align-items: center; gap: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; margin-bottom: 16px; flex-wrap: wrap; }
.toolbar-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.toolbar input, .toolbar select { border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 7px; padding: 8px 9px; font-size: 12px; }
.update-time { font-size: 12px; color: var(--muted); }
.main-grid { display: grid; grid-template-columns: 245px minmax(0, 1fr) 330px; gap: 18px; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px; box-shadow: 0 1px 2px rgba(0, 0, 0, .03); }
.card h3 { font-size: 14px; margin: 0 0 12px; }
.patient-list { max-height: 760px; overflow-y: auto; }
.patient-button { width: 100%; border: 1px solid var(--line); background: var(--soft); color: var(--text); padding: 10px; margin-bottom: 8px; border-radius: 8px; text-align: left; cursor: pointer; }
