    const ref = fbDb.ref(`${FEEDBACK_ROOT}/${p.id}`).limitToLast(200);
    ref.once('value').then(snap => {
      const list = state[p.id].feedback;
      snap.forEach(child => {
        const key = child.key, val = child.val();
        if (val && !list.some(f => f.id === key)) {
          list.push({id: key, author: val.author, role: val.role, time: val.time, ts: val.ts || tsFromPushKey(key), text: val.text, unread: false});
        }
      });
      if (p.id === selectedPatientId) renderFeedback();
      /* 초기 로딩 이후 새로 올라오는 피드백만 실시간 반영 */
      ref.on('child_added', s2 => {
        const key = s2.key, val = s2.val();
        const list2 = state[p.id].feedback;
        if (!val || list2.some(f => f.id === key)) return;
        list2.push({id: key, author: val.author, role: val.role, time: val.time, ts: val.ts || tsFromPushKey(key), text: val.text, unread: val.author !== me.name});
        if (p.id === selectedPatientId) renderFeedback();
        if (val.author !== me.name) log('수신', `${p.name} 피드백 수신 — ${val.author}`);
      });
      ref.on('child_removed', s3 => {
        const key = s3.key;
        const list3 = state[p.id].feedback;
        const i = list3.findIndex(f => f.id === key);
        if (i >= 0) { list3.splice(i, 1); if (p.id === selectedPatientId) renderFeedback(); }
      });
    }).catch(err => console.warn('Firebase 피드백 초기 로드 실패', err));
  });
}
function stopFeedbackSync() {
  if (!fbReady || !fbDb) return;
  patients.forEach(p => fbDb.ref(`${FEEDBACK_ROOT}/${p.id}`).off());
  feedbackListenersAttached = false;
}

/* ============ 메시지 실시간 공유 (다른 컴퓨터/브라우저 포함) ============ */
function startMessageSync() {
  if (!fbReady || !fbDb || messageListenerAttached) return;
  messageListenerAttached = true;
  const ref = fbDb.ref(MESSAGES_PATH).limitToLast(200);
  ref.once('value').then(snap => {
    messages = [];
    snap.forEach(child => {
      const key = child.key, val = child.val();
      if (val) messages.push({_key: key, doctor: val.doctor, time: val.time, ts: val.ts || tsFromPushKey(key), text: val.text, patient: val.patient});
    });
    renderMessages();
    ref.on('child_added', s2 => {
      const key = s2.key, val = s2.val();
      if (!val || messages.some(m => m._key === key)) return;
      messages.push({_key: key, doctor: val.doctor, time: val.time, ts: val.ts || tsFromPushKey(key), text: val.text, patient: val.patient});
      renderMessages();
    });
  }).catch(err => console.warn('Firebase 메시지 초기 로드 실패', err));
}
function stopMessageSync() {
  if (fbReady && fbDb) fbDb.ref(MESSAGES_PATH).off();
  messageListenerAttached = false;
}

/* ============ 로그인 ============
   Firebase Authentication(이메일/비밀번호)으로 실제 인증을 받습니다.
   화면에는 여전히 이름 선택 + 비밀번호만 보이고, 이메일 변환은
   내부적으로 ACCOUNTS 매핑을 거쳐 자동으로 처리됩니다. */
function loginUser() {
  const name = document.getElementById('doctorSelect').value;
  const pw = document.getElementById('passwordInput').value;
  const err = document.getElementById('loginError');
  const btn = document.querySelector('.login-submit');
  if (!name) { err.textContent = '의료진을 선택하세요.'; return; }
  if (!pw) { err.textContent = '비밀번호를 입력하세요.'; return; }
  err.textContent = '';

  if (!fbReady || !fbAuth) {
    err.textContent = 'Firebase 인증 서버에 연결할 수 없습니다. 네트워크 상태를 확인하세요.';
    return;
  }

  const email = ACCOUNTS[name].email;
  if (btn) { btn.disabled = true; btn.textContent = '로그인 중...'; }
  fbAuth.signInWithEmailAndPassword(email, pw)
    .then(() => {
      err.textContent = '';
      me = {name, role: ACCOUNTS[name].role, sid: ACCOUNTS[name].sid};
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('mainApp').style.display = 'block';
      document.getElementById('userInfo').textContent = `${me.name} · ${me.role} (${me.sid}) · 로그인됨`;
      const lbl = document.getElementById('msgSenderLabel');
      if (lbl) lbl.textContent = `${me.name} · ${me.role}`;
      viewMode = store.get('vitalSign_viewMode_' + name) === 'mine' ? 'mine' : 'all';
      if (!booted) { init(); booted = true; } else { renderAll(); }
      startRealTimeSync();
      startFeedbackSync();
      startMessageSync();
      startInterventionSync();
      startChecklistSync();
      startAssignmentSync();
      startBundleSync();
      log('인증', '로그인');
    })
    .catch(e => {
      const map = {
        'auth/wrong-password': '비밀번호가 올바르지 않습니다. 다시 입력하세요.',
        'auth/invalid-credential': '비밀번호가 올바르지 않습니다. 다시 입력하세요.',
        'auth/user-not-found': '등록되지 않은 계정입니다. 관리자에게 문의하세요.',
        'auth/too-many-requests': '로그인 시도가 너무 많습니다. 잠시 후 다시 시도하세요.',
        'auth/network-request-failed': '네트워크 연결을 확인하세요.'
      };
      err.textContent = map[e.code] || `로그인에 실패했습니다. (${e.code || e.message})`;
      document.getElementById('passwordInput').select();
    })
    .finally(() => {
      if (btn) { btn.disabled = false; btn.textContent = '로그인'; }
    });
}

function logout() {
  if (!confirm('로그아웃하시겠습니까? 이번 세션에 입력한 피드백과 메시지는 화면에 그대로 남습니다.')) return;
  log('인증', '로그아웃');
  stopRealTimeSync();
  stopFeedbackSync();
  stopMessageSync();
  stopInterventionSync();
  stopChecklistSync();
  stopAssignmentSync();
  stopBundleSync();
  if (autoTimer) { clearInterval(autoTimer); autoTimer = null; }
  document.getElementById('autoRefresh').checked = false;
  if (fbReady && fbAuth) fbAuth.signOut().catch(e => console.warn('Firebase 로그아웃 실패', e));
  document.getElementById('loginScreen').style.display = 'flex';
  document.getElementById('mainApp').style.display = 'none';
  document.getElementById('doctorSelect').value = '';
  document.getElementById('passwordInput').value = '';
  document.getElementById('loginError').textContent = '';
}

/* ============ 유틸 ============ */
function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }
function nowT() { return new Date().toLocaleTimeString('ko-KR'); }
/* 날짜 + 시간 표시: 2026.09.16 오후 3:12:05 */
function fmtDT(ts) {
  const d = new Date(ts);
  if (isNaN(d)) return '';
  return `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')} ${d.toLocaleTimeString('ko-KR')}`;
}
/* ts가 없는 예전 기록은 Firebase push 키에 들어 있는 생성 시각을 복원 */
function tsFromPushKey(key) {
  const CH = '-0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ_abcdefghijklmnopqrstuvwxyz';
  if (typeof key !== 'string' || key.length < 8) return null;
  let t = 0;
  for (let i = 0; i < 8; i++) { const v = CH.indexOf(key[i]); if (v < 0) return null; t = t * 64 + v; }
  return (t > 1.4e12 && t < Date.now() + 864e5) ? t : null;
}
/* '-3시간', '-20분' 같은 상대 시각을 실제 시각으로 변환 */
function tsFromRelative(str) {
  const m = /^-(\d+)(시간|분)$/.exec(str || '');
  return m ? Date.now() - Number(m[1]) * (m[2] === '시간' ? 3600e3 : 60e3) : null;
}
function itemDT(it, key) {
  const ts = it.ts || tsFromPushKey(key);
  return ts ? fmtDT(ts) : (it.time || '');
}
function mapOf(v) { return Math.round((v.sysBloodPress + 2 * v.dbp) / 3); }
function agoText(ts) {
  if (!ts) return '-';
  const m = Math.max(0, Math.floor((Date.now() - ts) / 60000));
  if (m < 1) return '방금';
  if (m < 60) return `${m}분 전`;
  return `${Math.floor(m / 60)}시간${m % 60 ? ` ${m % 60}분` : ''} 전`;
}
function esc(s) { return String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function log(kind, action) {
  const entry = {time: nowT(), user: me.name, kind, action, _ts: Date.now()};
  pushAuditEntry(entry);
}

/* 환자 ID 기반 고정 난수 — 새로고침해도 같은 환자는 같은 이력이 나옵니다 */
function seeded(seed) { let x = seed; return function () { x = (x * 1103515245 + 12345) % 2147483648; return x / 2147483648; }; }
function seedOf(id) { let h = 0; for (const c of id) h = (h * 31 + c.charCodeAt(0)) % 100000; return h + 7; }

function jitter(base, key) { const spread = {temperature: 0.25, heartRate: 6, respRate: 3, sysBloodPress: 8, dbp: 5, spO2: 2}[key]; let v = base + (Math.random() - 0.5) * spread * 2; return key === 'temperature' ? Math.round(v * 10) / 10 : Math.round(clamp(v, key === 'spO2' ? 70 : 0, key === 'spO2' ? 100 : 999)); }
function calcRisk(v, lab) { lab = lab || {}; let s = 5; if (v.temperature >= 38) s += 18; if (v.temperature < 36) s += 12; if (v.heartRate > 100) s += 18; if (v.heartRate > 120) s += 8; if (v.respRate > 20) s += 18; if (v.respRate >= 25) s += 8; if (v.sysBloodPress < 100) s += 18; if (v.sysBloodPress < 90) s += 10; if (v.spO2 < 95) s += 12; if (v.spO2 < 92) s += 7; if (v.dbp != null && mapOf(v) < 65) s += 10; if (lab.lactate >= 2) s += 8; if (lab.lactate >= 4) s += 10; if (v.gcs != null && v.gcs < 15) s += 12; if (lab.wbc > 12 || lab.wbc < 4) s += 6; return clamp(Math.round(s), 0, 100); }
function getStatus(score) { return score >= 70 ? '위험' : score >= 45 ? '주의' : '정상'; }
function statusClass(s) { return s === '위험' ? 'danger' : s === '주의' ? 'warning' : 'success'; }
function statusColor(s) { return s === '위험' ? 'var(--red)' : s === '주의' ? 'var(--amber)' : 'var(--green)'; }

/* 현재값에서 과거 방향으로 역산 — 마지막 점(23번)이 항상 현재 생체신호와 일치합니다 */
function generateTrend(baseVitals, lab) {
  const keys = ['temperature', 'heartRate', 'respRate', 'sysBloodPress', 'dbp', 'spO2'];
  const out = [];
  let v = {...baseVitals};
  for (let i = 22; i >= 0; i--) {
    const nv = {};
    keys.forEach(k => { nv[k] = jitter(v[k] + (baseVitals[k] - v[k]) * 0.25, k); });
    v = nv;
    out.unshift({...v, gcs: baseVitals.gcs, risk: calcRisk({...v, gcs: baseVitals.gcs}, lab)});
  }
  out.push({...baseVitals, risk: calcRisk(baseVitals, lab)});
  return out;
}

/* 7일 이력 — 환자별 고정 시드 */
function generateHistory(p, currentRisk) {
  const rnd = seeded(seedOf(p.id));
  const drivers = ['체온 상승', '심박수 증가', '호흡수 증가', '혈압 저하', 'SpO₂ 저하', '백혈구 수치 변동', '젖산 상승'];
  const out = []; let r = currentRisk;
  for (let i = 0; i < 7; i++) {
    const d = new Date(); d.setDate(d.getDate() - i);
    out.push({date: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`, risk: clamp(Math.round(r), 5, 100), driver: drivers[Math.floor(rnd() * drivers.length)]});
    r = r - (rnd() * 9 + 1);
  }
  return out;
}

/* ============ 초기화 ============ */
function init() {
  patients.forEach(p => {
    const vitals = {...p.base};
    const labs = {...p.labs, ts: Date.now() - p.labs.ago * 60000};
    const risk = calcRisk(vitals, labs);
    const trend = generateTrend(vitals, labs);
    state[p.id] = {vitals, prevVitals: {...vitals}, risk, prevRisk: clamp(trend[trend.length - 2] ? trend[trend.length - 2].risk : risk, 0, 100), trend, labs, feedback: [], alarms: [], checklist: null, interventions: [], assignedDoctor: p.doc || '', assignedNurse: p.nurse || '', riskTimeline: [], bundle: emptyBundle()};
    state[p.id].history = generateHistory(p, risk);
    state[p.id].feedback = (seedFeedback[p.id] || []).map(f => ({id: 'seed-' + p.id + '-' + (fbSeq++), author: f[0], role: f[1], time: f[2], ts: tsFromRelative(f[2]), text: f[3], own: false, unread: false}));
    state[p.id].riskTimeline.push({time: nowT(), risk, driver: reasonsFor(vitals, labs)[0]});
    syncChecklist(p.id);
    evaluateAlarms(p.id, true);
  });
  patients.forEach(p => maybeAutoStartBundle(p.id));
  if (!bundleTickTimer) bundleTickTimer = setInterval(tickBundles, 1000);
  if (channel) channel.onmessage = e => receiveFeedback(e.data);
  updateTime();
  log('시스템', '대시보드 시작');
  if (!alarmTickTimer) alarmTickTimer = setInterval(() => { if (document.getElementById('alarmList')) renderAlarms(); }, 30000);
  renderAll();
}

/* ============ 탭 ============ */
function switchTab(tabName, btn) {
  document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(tabName).classList.add('active');
  if (btn) btn.classList.add('active');
  renderAll();
  log('조회', `${tabName} 탭 열기`);
}

/* ============ 환자 리스트 ============ */
function renderPatientList() {
  let list = [...visiblePatients()];
  const q = (document.getElementById('searchInput').value || '').trim().toLowerCase();
  if (q) list = list.filter(p => (p.name + p.room + p.id).toLowerCase().includes(q));
  const sf = document.getElementById('statusFilterSelect').value || '전체';
  if (sf !== '전체') list = list.filter(p => getStatus(state[p.id].risk) === sf);
  const mode = document.getElementById('sortSelect').value || 'risk';
  if (mode === 'risk') list.sort((a, b) => state[b.id].risk - state[a.id].risk);
  else if (mode === 'rise') list.sort((a, b) => (state[b.id].risk - state[b.id].prevRisk) - (state[a.id].risk - state[a.id].prevRisk));
  else if (mode === 'room') list.sort((a, b) => a.room.localeCompare(b.room));

  const el = document.getElementById('patientList');
  if (!list.length) { el.innerHTML = `<div class="empty">${viewMode === 'mine' && !visiblePatients().length ? '담당으로 지정된 환자가 없습니다.' : '조건에 맞는 환자가 없습니다. 검색어나 필터를 바꿔보세요.'}</div>`; return; }
  el.innerHTML = list.map(p => {
    const s = state[p.id], status = getStatus(s.risk), rise = s.risk - s.prevRisk;
    const docTag = s.assignedDoctor ? ` · 담당 ${esc(s.assignedDoctor)}` : ' · 담당의 미지정';
    const bs = bundleStatus(p.id);
    const bChip = bs.started && !bs.complete ? `<span class="bundle-chip ${bs.elapsed > BUNDLE_WINDOW ? 'over' : ''}" data-pid="${p.id}">${bundleChipText(bs)}</span>` : '';
    return `<button class="patient-button ${p.id === selectedPatientId ? 'active' : ''}" onclick="selectPatient('${p.id}')"><div class="patient-top"><span class="patient-name">${p.name}</span><span><span class="badge ${statusClass(status)}">${status}</span>${rise >= 8 ? '<span class="trend-up">▲ 급상승</span>' : ''}${bChip}</span></div><div class="patient-info">${p.room} · ${p.age}세 · 위험도 ${s.risk}%${docTag}${p.code === 'DNR' ? ' · DNR' : ''}</div></button>`;
  }).join('');
}

/* ============ 메인 대시보드 ============ */
function renderDashboard() {
  const p = patients.find(x => x.id === selectedPatientId);
  if (!p) return;
  const s = state[p.id], v = s.vitals, status = getStatus(s.risk), diff = s.risk - s.prevRisk;

  document.getElementById('patientName').textContent = `${p.name} · ${p.room}`;
  document.getElementById('patientInfo').textContent = `${p.age}세 · ${p.gender} · ${p.dx} · 환자 ID ${p.id}`;
  document.getElementById('riskScore').textContent = s.risk;
  document.getElementById('riskScore').style.color = statusColor(status);
  document.getElementById('scoreChange').textContent = `이전 대비 ${diff >= 0 ? '+' : ''}${diff}%`;
  document.getElementById('scoreChange').style.color = diff > 0 ? 'var(--red)' : diff < 0 ? 'var(--green)' : 'var(--muted)';

  const ind = document.getElementById('statusIndicator');
  ind.textContent = `상태: ${status}`;
  ind.className = `status-indicator ${statusClass(status)}`;

  const pb = document.getElementById('priorityBadge');
  pb.textContent = diff >= 8 ? '급격한 상승' : '모니터링';
  pb.className = `badge ${diff >= 8 ? 'danger' : statusClass(status)}`;

  document.getElementById('safetyBanner').innerHTML = safetyChips(p);
  document.getElementById('reasonList').innerHTML = reasonsFor(v, s.labs).slice(0, 4).map(x => `<li>${x}</li>`).join('');

  if (status === '위험') {
    document.getElementById('guideBox').innerHTML = '<strong>🔴 위험 단계 — 의료진 즉시 확인 필요</strong><p>생체신호 재확인 및 담당 의료진 보고를 권고합니다.</p>';
    document.getElementById('actionBox').innerHTML = '<h4>🚨 권장 조치 — 즉시 개입 필요</h4><ul><li>아래 Hour-1 번들을 1시간 안에 진행 (혈액배양 → 항생제 순서)</li><li>평균동맥압(MAP) 65 mmHg 이상 유지</li><li>의식 수준과 소변량 변화 관찰</li><li>담당 전공의 즉시 보고</li></ul>';
    document.getElementById('actionBox').className = 'action-box danger';
  } else if (status === '주의') {
    document.getElementById('guideBox').innerHTML = '<strong>🟡 주의 단계 — 관찰 강화</strong><p>생체신호 변화를 면밀히 관찰하세요.</p>';
    document.getElementById('actionBox').innerHTML = '<h4>⚠️ 권장 조치 — 관찰 강화 필요</h4><ul><li>활력징후 15~30분 간격 재측정</li><li>혈액검사 오더 고려</li><li>수액 공급 상태 점검</li><li>환자 상태 지속 관찰</li></ul>';
    document.getElementById('actionBox').className = 'action-box warning';
  } else {
    document.getElementById('guideBox').innerHTML = '<strong>🟢 정상 단계 — 지속 모니터링</strong><p>현재 비교적 안정적입니다.</p>';
    document.getElementById('actionBox').innerHTML = '<h4>✅ 권장 조치 — 정기 모니터링</h4><ul><li>4시간 간격 정기 측정</li><li>특이사항 발생 시 즉시 재평가</li></ul>';
    document.getElementById('actionBox').className = 'action-box success';
  }

  renderBundle();
  renderVitals(s);
  renderShap(v, s.labs);
  renderChartTabs();
  drawTrendChart();
  renderAlarms();
  renderFeedback();
  renderInterventions();
  renderAssignment();
}

function reasonsFor(v, lab) {
  lab = lab || {};
  const r = [];
  if (v.dbp != null && mapOf(v) < 65) r.push('평균동맥압(MAP) 저하 (' + mapOf(v) + ' mmHg)');
  if (lab.lactate >= 4) r.push('젖산 크게 상승 (' + lab.lactate + ' mmol/L)');
  else if (lab.lactate >= 2) r.push('젖산 상승 (' + lab.lactate + ' mmol/L)');
  if (v.gcs != null && v.gcs < 15) r.push('의식 저하 (GCS ' + v.gcs + ')');
  if (v.sysBloodPress < 90) r.push('수축기 혈압이 매우 낮음 (' + v.sysBloodPress + ' mmHg)');
  else if (v.sysBloodPress < 100) r.push('수축기 혈압이 낮음 (' + v.sysBloodPress + ' mmHg)');
  if (v.respRate > 20) r.push('호흡수가 증가 (' + v.respRate + '/min)');
  if (v.heartRate > 100) r.push('심박수가 빠름 (' + v.heartRate + ' bpm)');
  if (v.temperature >= 38) r.push('체온이 상승 (' + v.temperature + '°C)');
  if (v.spO2 < 95) r.push('SpO₂가 낮음 (' + v.spO2 + '%)');
  if (lab.wbc > 12 || lab.wbc < 4) r.push('백혈구 수치 이상 (' + lab.wbc + ' ×10³/µL)');
  if (!r.length) r.push('생체신호가 안정적');
  return r;
}

function renderVitals(s) {
  const v = s.vitals, pv = s.prevVitals || v;
  const defs = [['temperature', '체온'], ['heartRate', '심박'], ['respRate', '호흡'], ['sysBloodPress', 'SBP'], ['spO2', 'SpO₂']];
  document.getElementById('vitalsGrid').innerHTML = defs.map(([k, l]) => {
    const [lo, hi] = ranges[k], ab = v[k] < lo || v[k] > hi;
    const d = Math.round((v[k] - pv[k]) * 10) / 10;
    const up = k === 'spO2' || k === 'sysBloodPress' ? d < 0 : d > 0;
    const dTxt = d === 0 ? '변화 없음' : `${d > 0 ? '▲' : '▼'} ${Math.abs(d)}${units[k].trim()}`;
    return `<div class="vital-card ${ab ? 'abnormal' : ''}"><div class="vital-label">${l}</div><div class="vital-value">${v[k]}${units[k]}</div><div class="vital-delta" style="color:${d === 0 ? 'var(--muted)' : up ? 'var(--red)' : 'var(--green)'}">${dTxt}</div><div class="vital-range">범위 ${lo}–${hi}${units[k]}</div></div>`;
  }).join('') + (() => {
    const lab = s.labs || {}, map = mapOf(v), pmap = pv.dbp != null ? mapOf(pv) : map, dm = map - pmap;
    const card = (label, value, abnormal, delta, deltaColor, range) => `<div class="vital-card ${abnormal ? 'abnormal' : ''}"><div class="vital-label">${label}</div><div class="vital-value">${value}</div><div class="vital-delta" style="color:${deltaColor}">${delta}</div><div class="vital-range">${range}</div></div>`;
    return card('MAP', `${map} mmHg`, map < 65, dm === 0 ? '변화 없음' : `${dm > 0 ? '▲' : '▼'} ${Math.abs(dm)}mmHg`, dm === 0 ? 'var(--muted)' : dm < 0 ? 'var(--red)' : 'var(--green)', '목표 ≥65 mmHg')
      + card('젖산', `${lab.lactate} mmol/L`, lab.lactate >= 2, `검사 ${agoText(lab.ts)}`, lab.lactate >= 4 ? 'var(--red)' : 'var(--muted)', '정상 <2.0 mmol/L')
      + card('의식 (GCS)', `${v.gcs} / 15`, v.gcs < 15, v.gcs < 15 ? '의식 저하' : '명료', v.gcs < 15 ? 'var(--red)' : 'var(--muted)', '15 = 명료');
  })();
}

function renderShap(v, lab) {
  lab = lab || {};
  const vals = [
    ['젖산', lab.lactate >= 4 ? 24 : lab.lactate >= 2 ? 16 : 3],
    ['MAP', mapOf(v) < 65 ? 22 : mapOf(v) < 70 ? 10 : 4],
    ['의식', v.gcs < 15 ? 20 : 2],
    ['혈압', v.sysBloodPress < 90 ? 28 : v.sysBloodPress < 100 ? 20 : 5],
    ['호흡수', v.respRate >= 25 ? 26 : v.respRate > 20 ? 18 : 5],
    ['심박수', v.heartRate > 120 ? 26 : v.heartRate > 100 ? 18 : 5],
    ['체온', v.temperature >= 39 ? 22 : v.temperature >= 38 ? 18 : 4],
    ['SpO₂', v.spO2 < 92 ? 19 : v.spO2 < 95 ? 12 : 3]
  ].sort((a, b) => b[1] - a[1]);
  const max = vals[0][1] || 1;
  document.getElementById('shapAnalysis').innerHTML = vals.map(([n, val]) => `<div class="shap-row"><div>${n}</div><div class="bar-bg"><div class="bar-fill ${val >= 18 ? 'hot' : ''}" style="width:${Math.round(val / max * 100)}%"></div></div><div class="shap-val">${val}</div></div>`).join('');
}

/* ============ 24시간 추이 차트 (실제 SVG 렌더링) ============ */
function renderChartTabs() {
  const keys = ['risk', 'temperature', 'heartRate', 'respRate', 'sysBloodPress', 'spO2'];
  document.getElementById('chartTabs').innerHTML = keys.map(k => `<button class="tab ${chartMetric === k ? 'active' : ''}" onclick="setMetric('${k}')">${labels[k]}</button>`).join('');
}
function setMetric(k) { chartMetric = k; renderChartTabs(); drawTrendChart(); }

function drawTrendChart() {
  const svg = document.getElementById('trendSvg');
  const s = state[selectedPatientId];
  if (!s) return;
  const data = s.trend.map(t => t[chartMetric]);
  const W = 900, H = 250, padL = 48, padR = 14, padT = 16, padB = 26;
  let min = Math.min(...data), max = Math.max(...data);
  if (chartMetric === 'risk') { min = 0; max = 100; } else {
    if (max - min < 1) { max = max + 1; min = min - 1; }
    const pad = (max - min) * 0.12; min -= pad; max += pad;
  }
  const x = i => padL + i * (W - padL - padR) / (data.length - 1);
  const y = val => padT + (H - padT - padB) * (1 - (val - min) / (max - min));

  const gridCount = 4;
  let grid = '';
  for (let g = 0; g <= gridCount; g++) {
    const val = min + (max - min) * g / gridCount;
    const gy = y(val);
    grid += `<line x1="${padL}" y1="${gy}" x2="${W - padR}" y2="${gy}" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />`;
    grid += `<text x="${padL - 6}" y="${gy + 4}" text-anchor="end" font-size="11" fill="var(--muted)">${chartMetric === 'temperature' ? val.toFixed(1) : Math.round(val)}</text>`;
  }

  const line = data.map((v, i) => `${i === 0 ? 'M' : 'L'} ${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
  const area = `${line} L ${x(data.length - 1).toFixed(1)} ${H - padB} L ${padL} ${H - padB} Z`;
  const status = getStatus(s.risk);
  const color = chartMetric === 'risk' ? statusColor(status) : 'var(--blue)';

  const last = data[data.length - 1];
  const dots = data.map((v, i) => i === data.length - 1 ? `<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="5" fill="${color}" stroke="var(--panel)" stroke-width="2" />` : '').join('');

  let threshold = '';
  if (chartMetric === 'risk') {
    threshold = `<line x1="${padL}" y1="${y(70)}" x2="${W - padR}" y2="${y(70)}" stroke="var(--red)" stroke-dasharray="5 4" stroke-width="1.5" vector-effect="non-scaling-stroke" /><text x="${W - padR - 4}" y="${y(70) - 5}" text-anchor="end" font-size="10" fill="var(--red)">위험 70%</text>`;
  } else {
    const [lo, hi] = ranges[chartMetric];
    if (hi >= min && hi <= max) threshold += `<line x1="${padL}" y1="${y(hi)}" x2="${W - padR}" y2="${y(hi)}" stroke="var(--amber)" stroke-dasharray="5 4" stroke-width="1.2" vector-effect="non-scaling-stroke" />`;
    if (lo >= min && lo <= max) threshold += `<line x1="${padL}" y1="${y(lo)}" x2="${W - padR}" y2="${y(lo)}" stroke="var(--amber)" stroke-dasharray="5 4" stroke-width="1.2" vector-effect="non-scaling-stroke" />`;
  }

  let xlab = '';
  [0, 6, 12, 18, 23].forEach(i => { xlab += `<text x="${x(i).toFixed(1)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="var(--muted)">${i === 23 ? '현재' : '-' + (23 - i) + 'h'}</text>`; });

  svg.innerHTML = `<defs><linearGradient id="grad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${color}" stop-opacity="0.28" /><stop offset="100%" stop-color="${color}" stop-opacity="0.02" /></linearGradient></defs>${grid}${threshold}<path d="${area}" fill="url(#grad)" /><path d="${line}" fill="none" stroke="${color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />${dots}${xlab}`;

  document.getElementById('chartLabel').textContent = `${labels[chartMetric]} · 현재 ${last}${units[chartMetric]} (최저 ${Math.min(...data)} / 최고 ${Math.max(...data)})`;
}

/* ============ 알람 (신규 구현) ============
   기존 문제: 위험 상태가 유지되는 동안 매 갱신(10초)마다 같은 알람이 계속 새로 쌓였음.
   수정: "상태 유지형" 조건은 새로 위험해진 순간(false→true 전이)에만 1번 울리도록 변경.
   급상승(riskSpike)은 매 갱신 시점의 변화량 자체가 이벤트이므로 예외적으로 유지. */
function evaluateAlarms(id, silent) {
  const s = state[id], v = s.vitals, lab = s.labs || {};
  if (!s.alarmState) s.alarmState = {};
  const conditions = {
    lowMAP: [mapOf(v) < 65, 'danger', `MAP ${mapOf(v)} mmHg — 목표(65) 미만`],
    highLactate: [lab.lactate >= 4, 'danger', `젖산 ${lab.lactate} mmol/L — 조직 저관류 의심`],
    lowGCS: [v.gcs < 15, 'warning', `GCS ${v.gcs} — 의식 저하`],
    riskDanger: [s.risk >= 70, 'danger', `패혈증 위험도 ${s.risk}% — 위험 단계 진입`],
    lowBP: [v.sysBloodPress < 90, 'danger', `수축기 혈압 ${v.sysBloodPress} mmHg — 저혈압`],
    lowSpO2: [v.spO2 < 92, 'danger', `SpO₂ ${v.spO2}% — 산소포화도 저하`],
    highTemp: [v.temperature >= 39, 'danger', `체온 ${v.temperature}°C — 고열`],
    highRR: [v.respRate >= 25, 'warning', `호흡수 ${v.respRate}/min — 빈호흡`],
    highHR: [v.heartRate > 120, 'warning', `심박수 ${v.heartRate} bpm — 빈맥`],
    fever: [v.temperature >= 38 && v.temperature < 39, 'warning', `체온 ${v.temperature}°C — 발열`],
  };
  const push = (lv, msg) => {
    s.alarms.push({id: Date.now() + Math.random(), level: lv, msg, time: nowT(), ts: Date.now(), acked: false});
    if (!silent && lv === 'danger') log('알람', `${id} ${msg}`);
  };
  // 상태 유지형 조건: false→true로 새로 넘어갈 때만 알람 발생
  Object.keys(conditions).forEach(key => {
    const [now, lv, msg] = conditions[key];
    const prev = !!s.alarmState[key];
    if (now && !prev) push(lv, msg);
    s.alarmState[key] = now;
  });
  // 급상승은 매 갱신 시점의 변화량 자체가 이벤트라 예외적으로 매번 평가
  if (s.risk - s.prevRisk >= 8) push('danger', `위험도 급상승 (+${s.risk - s.prevRisk}%p)`);
  if (s.alarms.length > 60) s.alarms = s.alarms.slice(-60);
}

function renderAlarms() {
  const s = state[selectedPatientId], el = document.getElementById('alarmList');
  if (!s.alarms.length) { el.innerHTML = '<div class="empty">임계값을 넘은 신호가 없습니다.</div>'; return; }
  const now = Date.now();
  el.innerHTML = s.alarms.slice().reverse().slice(0, 30).map(a => {
    const mins = Math.max(0, Math.floor((now - (a.ts || now)) / 60000));
    const stale = !a.acked && mins >= 5;
    const elapsedTxt = a.acked ? '' : (mins < 1 ? '방금 발생' : `⏱ ${mins}분 경과`);
    return `<div class="alarm ${a.level}-border ${a.acked ? 'acked' : ''} ${stale ? 'stale' : ''}"><div class="alarm-head"><span>${a.level === 'danger' ? '🔴 위험' : '🟡 주의'}</span><span>${a.time}</span></div><p class="alarm-msg">${esc(a.msg)}</p>${elapsedTxt ? `<p class="alarm-elapsed ${stale ? 'stale-text' : ''}">${elapsedTxt}${stale ? ' — 확인 지연' : ''}</p>` : ''}<div class="alarm-actions">${a.acked ? '<span class="acked-tag">확인됨</span>' : `<button class="ack-btn" onclick="ackAlarm('${selectedPatientId}',${a.id})">확인 처리</button>`}</div></div>`;
  }).join('');
  renderGlobalAlarmBadge();
}

function ackAlarm(patientId, alarmId) {
  const a = state[patientId].alarms.find(x => x.id === alarmId);
  if (a) { a.acked = true; log('조치', `${patientId} 알람 확인 처리`); }
  if (patientId === selectedPatientId) renderAlarms();
  else renderGlobalAlarmBadge();
  if (document.getElementById('unackModalOverlay').style.display !== 'none') renderUnackModal();
}

/* 환자 상관없이, 확인되지 않은 위험(danger) 알람 총 개수를 항상 헤더에 표시 */
function renderGlobalAlarmBadge() {
  const badge = document.getElementById('globalAlarmBadge');
  if (!badge) return;
  const count = visiblePatients().reduce((sum, p) => sum + (state[p.id] ? state[p.id].alarms.filter(a => !a.acked && a.level === 'danger').length : 0), 0);
  badge.textContent = `${viewMode === 'mine' ? '내 환자 ' : ''}미확인 위험 알람 ${count}건`;
  badge.className = `unack-badge ${count === 0 ? 'zero' : ''}`;
}

/* 배지를 누르면 전체 환자의 미확인 위험 알람을 모아서 보여줍니다 */
function openUnackModal() {
  renderUnackModal();
  document.getElementById('unackModalOverlay').style.display = 'flex';
}
function closeUnackModal() {
  document.getElementById('unackModalOverlay').style.display = 'none';
}
function renderUnackModal() {
  const el = document.getElementById('unackModalList');
  if (!el) return;
  const now = Date.now();
  const rows = [];
  visiblePatients().forEach(p => {
    const s = state[p.id];
    if (!s) return;
    s.alarms.forEach(a => { if (!a.acked && a.level === 'danger') rows.push({p, a}); });
  });
  rows.sort((x, y) => (y.a.ts || 0) - (x.a.ts || 0));
  if (!rows.length) { el.innerHTML = '<div class="empty">미확인 위험 알람이 없습니다.</div>'; return; }
  el.innerHTML = rows.map(({p, a}) => {
    const mins = Math.max(0, Math.floor((now - (a.ts || now)) / 60000));
    return `<div class="unack-modal-item"><div class="um-top"><span>${esc(p.name)} · ${esc(p.room)}</span><span>${mins < 1 ? '방금 발생' : `⏱ ${mins}분 경과`}</span></div><div>${esc(a.msg)}</div><div class="um-actions"><button class="btn btn-ghost" onclick="jumpToPatient('${p.id}')">환자 보기</button><button class="ack-btn" onclick="ackAlarm('${p.id}',${a.id})">확인 처리</button></div></div>`;
  }).join('');
}
/* 모달에서 특정 환자로 바로 이동 */
function jumpToPatient(patientId) {
  closeUnackModal();
  selectPatient(patientId);
  const firstTabBtn = document.querySelector('.tab-btn');
  switchTab('monitoring', firstTabBtn);
}

/* "비우기"는 이미 확인 처리된 알람만 정리 — 미확인 알람은 실수로 지워지지 않도록 보호 */
function clearAlarms() {
  const s = state[selectedPatientId];
  const before = s.alarms.length;
  s.alarms = s.alarms.filter(a => !a.acked);
  renderAlarms();
  log('조치', `${selectedPatientId} 확인된 알람 ${before - s.alarms.length}건 정리`);
}

/* ============ 의료진 조치 기록 ============ */
function recordIntervention(type) {
  const patientId = selectedPatientId;
  const payload = {type, label: INTERVENTION_LABELS[type] || type, doctor: me.name, role: me.role, time: nowT()};
  let id;
  if (fbReady && fbDb) {
    id = fbDb.ref(`${INTERVENTION_ROOT}/${patientId}`).push().key;
  } else {
    id = `${Date.now()}-${fbSeq++}`;
  }
  const item = {id, ...payload};
  state[patientId].interventions = state[patientId].interventions || [];
  state[patientId].interventions.push(item);
  if (patientId === selectedPatientId) renderInterventions();
  log('조치', `${patientId} ${payload.label} — ${me.name}`);
  if (fbReady && fbDb) {
    fbDb.ref(`${INTERVENTION_ROOT}/${patientId}/${id}`).set(payload).catch(err => console.warn('Firebase 조치 기록 실패', err));
  }
}

function renderInterventions() {
  const el = document.getElementById('interventionList');
  if (!el) return;
  const list = (state[selectedPatientId].interventions || []).slice().reverse().slice(0, 30);
  if (!list.length) { el.innerHTML = '<div class="empty">기록된 조치가 없습니다.</div>'; return; }
  el.innerHTML = list.map(it => `<div class="intervention-item"><span class="intervention-time">${it.time}</span><span class="intervention-label">${esc(it.label)}</span><span class="intervention-doctor">${esc(it.doctor)} · ${esc(it.role)}</span></div>`).join('');
}

function startInterventionSync() {
  if (!fbReady || !fbDb || interventionListenersAttached) return;
  interventionListenersAttached = true;
  patients.forEach(p => {
    const ref = fbDb.ref(`${INTERVENTION_ROOT}/${p.id}`).limitToLast(100);
    ref.once('value').then(snap => {
      const list = state[p.id].interventions = state[p.id].interventions || [];
      snap.forEach(child => {
        const key = child.key, val = child.val();
        if (val && !list.some(x => x.id === key)) list.push({id: key, ...val});
      });
      if (p.id === selectedPatientId) renderInterventions();
      ref.on('child_added', s2 => {
        const key = s2.key, val = s2.val();
        const list2 = state[p.id].interventions;
        if (!val || list2.some(x => x.id === key)) return;
        list2.push({id: key, ...val});
        if (p.id === selectedPatientId) renderInterventions();
      });
    }).catch(err => console.warn('Firebase 조치 기록 초기 로드 실패', err));
  });
}
function stopInterventionSync() {
  if (fbReady && fbDb) patients.forEach(p => fbDb.ref(`${INTERVENTION_ROOT}/${p.id}`).off());
  interventionListenersAttached = false;
}

/* ============ 환자별 담당 의료진/간호사 지정 ============ */
function updateAssignment() {
  const patientId = selectedPatientId;
  const doctor = (document.getElementById('assignedDoctorSelect') || {}).value || '';
  const nurse = (document.getElementById('assignedNurseSelect') || {}).value || '';
  state[patientId].assignedDoctor = doctor;
  state[patientId].assignedNurse = nurse;
  log('조치', `${patientId} 담당 배정 변경 (전공의: ${doctor || '-'} / 간호사: ${nurse || '-'})`);
  if (fbReady && fbDb) {
    fbDb.ref(`${ASSIGNMENT_ROOT}/${patientId}`).set({doctor, nurse, updatedBy: me.name, time: nowT()}).catch(err => console.warn('Firebase 담당 배정 저장 실패', err));
  }
  renderAll();
}

function renderAssignment() {
  const s = state[selectedPatientId];
  const ds = document.getElementById('assignedDoctorSelect'), ns = document.getElementById('assignedNurseSelect');
  if (ds) ds.value = s.assignedDoctor || '';
  if (ns) ns.value = s.assignedNurse || '';
}

function startAssignmentSync() {
  if (!fbReady || !fbDb || assignmentListenerAttached) return;
  assignmentListenerAttached = true;
  patients.forEach(p => {
    fbDb.ref(`${ASSIGNMENT_ROOT}/${p.id}`).on('value', snap => {
      const val = snap.val();
      if (!state[p.id]) return;
      /* 아직 배정 기록이 없는 환자는 기본 담당을 사용 — 한 번이라도 저장되면 저장값(미지정 포함)을 따릅니다 */
      state[p.id].assignedDoctor = val ? (val.doctor || '') : (p.doc || '');
      state[p.id].assignedNurse = val ? (val.nurse || '') : (p.nurse || '');
      if (viewMode === 'mine') { renderAll(); return; }
      if (p.id === selectedPatientId) renderAssignment();
      renderPatientList();
      renderViewToggle();
    });
  });
}
function stopAssignmentSync() {
  if (fbReady && fbDb) patients.forEach(p => fbDb.ref(`${ASSIGNMENT_ROOT}/${p.id}`).off());
  assignmentListenerAttached = false;
}

/* ============ 위험도 변화 타임라인 ============ */
function renderRiskTimeline() {
  const el = document.getElementById('riskTimelineList');
  if (!el) return;
  const list = (state[selectedPatientId].riskTimeline || []).slice().reverse();
  if (!list.length) { el.innerHTML = '<div class="empty">아직 기록된 변화가 없습니다.</div>'; return; }
  el.innerHTML = list.map(t => `<div class="timeline-item"><span class="timeline-time">${t.time}</span><span class="timeline-risk" style="color:${statusColor(getStatus(t.risk))}">${t.risk}%</span><span class="timeline-driver">${esc(t.driver)}</span></div>`).join('');
}

/* ============ 공유 피드백 ============ */
function addFeedback() {
  const input = document.getElementById('feedbackInput');
  const text = input.value.trim();
  if (!text) return;
  const patientId = selectedPatientId;
  const payload = {author: me.name, role: me.role, time: nowT(), ts: Date.now(), text};
  let id;
  if (fbReady && fbDb) {
    id = fbDb.ref(`${FEEDBACK_ROOT}/${patientId}`).push().key;
  } else {
    id = `${Date.now()}-${fbSeq++}`;
  }
  const item = {id, ...payload, own: true, unread: false};
  state[patientId].feedback.push(item);
  input.value = '';
  renderFeedback();
  log('기록', `${patientId} 피드백 공유 — ${me.name}`);
  if (fbReady && fbDb) {
    /* 공용 데이터베이스에 저장 → 다른 컴퓨터/브라우저의 의료진도 즉시 확인 가능 */
    fbDb.ref(`${FEEDBACK_ROOT}/${patientId}/${id}`).set(payload).catch(err => console.warn('Firebase 피드백 기록 실패', err));
  } else if (channel) {
    channel.postMessage({patientId, item: {...item, own: false, unread: true}});
  }
}

/* 다른 탭(다른 의료진)에서 올라온 피드백 수신 */
function receiveFeedback(data) {
  if (!data || !state[data.patientId]) return;
  const list = state[data.patientId].feedback;
  if (list.some(f => f.id === data.item.id)) return;
  list.push(data.item);
  const p = patients.find(x => x.id === data.patientId);
  log('수신', `${p.name} 피드백 수신 — ${data.item.author}`);
  if (data.patientId === selectedPatientId) renderFeedback();
}

/* 발표용: 동료 한 명이 방금 피드백을 남긴 상황을 재현합니다 */
function simulateIncoming() {
  const pool = [['오세훈', '감염내과', '항생제 반응 확인했습니다. 24시간 뒤 재평가 예정입니다.'], ['이아연', '당직의', '방금 회진 다녀왔습니다. 활력징후 변화 없어 현 처치 유지합니다.'], ['정하늘', 'ICU 간호사', '수액 라인 교체 완료했고 소변량 정상 유지 중입니다.'], ['하유진', '전공의', '검사 결과 확인 후 다시 의견 남기겠습니다.']].filter(x => x[0] !== me.name);
  const pick = pool[Math.floor(Math.random() * pool.length)];
  receiveFeedback({patientId: selectedPatientId, item: {id: `sim-${Date.now()}-${fbSeq++}`, author: pick[0], role: pick[1], time: nowT(), ts: Date.now(), text: pick[2], own: false, unread: true}});
  renderFeedback();
}

function deleteFeedback(id) {
  const patientId = selectedPatientId;
  const list = state[patientId].feedback;
  const i = list.findIndex(f => f.id === id);
  if (i < 0 || list[i].author !== me.name) return;
  list.splice(i, 1);
  renderFeedback();
  log('기록', `${patientId} 내 피드백 삭제`);
  if (fbReady && fbDb) {
    fbDb.ref(`${FEEDBACK_ROOT}/${patientId}/${id}`).remove().catch(err => console.warn('Firebase 피드백 삭제 실패', err));
  }
}

function renderFeedback() {
  const el = document.getElementById('feedbackList');
  if (!el) return;
  const all = state[selectedPatientId].feedback;
  const filter = (document.getElementById('fbFilter') || {}).value || 'all';
  const mine = f => f.author === me.name;
  const fb = all.filter(f => filter === 'mine' ? mine(f) : filter === 'others' ? !mine(f) : true);

  const badge = document.getElementById('fbUnread');
  const unread = all.filter(f => f.unread).length;
  if (badge) { badge.textContent = unread; badge.style.display = unread ? 'inline-block' : 'none'; }

  if (!fb.length) {
    el.innerHTML = `<div class="empty">${filter === 'mine' ? '내가 남긴 피드백이 없습니다.' : filter === 'others' ? '동료가 남긴 피드백이 없습니다.' : '이 환자에 대한 피드백이 아직 없습니다. 첫 의견을 남겨보세요.'}</div>`;
  } else {
    el.innerHTML = fb.slice().reverse().map(f => `<div class="feedback-item ${mine(f) ? 'own' : f.unread ? 'unread' : ''}"><div><div class="feedback-meta"><span class="author">${esc(f.author)}</span><span class="role-tag">${esc(f.role)}</span><span>${esc(itemDT(f, f.id))}</span>${f.unread ? '<span class="new-dot">NEW</span>' : ''}${mine(f) ? '<span class="role-tag" style="border-color:var(--green);color:var(--green)">나</span>' : ''}</div><div>${esc(f.text)}</div></div>${mine(f) ? `<button class="link-btn" onclick="deleteFeedback('${f.id}')">삭제</button>` : ''}</div>`).join('');
  }

  /* 모니터링 탭에서 실제로 본 항목은 읽음 처리 */
  if (document.getElementById('monitoring').classList.contains('active')) {
    setTimeout(() => { let changed = false; all.forEach(f => { if (f.unread) { f.unread = false; changed = true; } }); if (changed && badge) badge.style.display = 'none'; }, 2500);
  }
}

/* ============ 환자 차트 탭 ============ */
function renderChartTab() {
  const p = patients.find(x => x.id === selectedPatientId), v = state[p.id].vitals;
  const lab = state[p.id].labs, map = mapOf(v);
  document.getElementById('chartSafetyBanner').innerHTML = safetyChips(p);
  document.getElementById('chartPatientLabel').textContent = `${p.name} · ${p.room} · ${p.dx} · 최근 검사 ${agoText(lab.ts)}`;
  const rows = [['체온', v.temperature + '°C', '36–37.5', v.temperature > 38.5 || v.temperature < 36], ['심박', v.heartRate + ' bpm', '60–100', v.heartRate > 120], ['호흡', v.respRate + '/min', '12–20', v.respRate > 25], ['혈압', v.sysBloodPress + '/' + v.dbp + ' mmHg', '90–140 / 60–90', v.sysBloodPress < 90], ['평균동맥압 (MAP)', map + ' mmHg', '65 이상', map < 65], ['SpO₂', v.spO2 + '%', '95 이상', v.spO2 < 94], ['의식 (GCS)', v.gcs + ' / 15', '15', v.gcs < 15], ['젖산', lab.lactate + ' mmol/L', '2.0 미만', lab.lactate >= 2], ['백혈구 (WBC)', lab.wbc + ' ×10³/µL', '4–12', lab.wbc > 12 || lab.wbc < 4], ['크레아티닌', lab.cr + ' mg/dL', '0.6–1.2', lab.cr > 1.2], ['혈소판', lab.plt + ' ×10³/µL', '150–400', lab.plt < 150], ['총 빌리루빈', lab.bili + ' mg/dL', '0.2–1.2', lab.bili > 1.2]];
  document.getElementById('chartTableBody').innerHTML = rows.map(r => `<tr><td>${r[0]}</td><td><strong>${r[1]}</strong></td><td>${r[2]}</td><td>${r[3] ? '⚠️ 이상' : '✓ 정상'}</td></tr>`).join('');

  const e = emr[p.id] || {meds: [], procs: []};
  document.getElementById('medicationList').innerHTML = e.meds.length ? e.meds.map(m => `<div class="subcard" style="font-size:12px;display:flex;justify-content:space-between;gap:10px;"><span><strong>${m[0]}</strong> · ${m[1]}</span><span style="color:var(--muted)">${m[2]}</span></div>`).join('') : '<div class="empty">투여 기록 없음</div>';
  document.getElementById('procedureList').innerHTML = e.procs.length ? e.procs.map(m => `<div class="subcard" style="font-size:12px;"><strong>${m[0]}</strong> · ${m[1]}</div>`).join('') : '<div class="empty">시술 기록 없음</div>';
}

/* ============ 이력 탭 (환자별 + 그래프) ============ */
function renderHistoryTab() {
  const p = patients.find(x => x.id === selectedPatientId), h = state[p.id].history;
  document.getElementById('historyPatientLabel').textContent = `${p.name} · ${p.room} · 최근 7일`;
  document.getElementById('historyTableBody').innerHTML = h.map(d => {
    const st = getStatus(d.risk);
    return `<tr><td>${d.date}</td><td><strong>${d.risk}%</strong></td><td><span class="badge ${statusClass(st)}">${st}</span></td><td>${d.driver}</td></tr>`;
  }).join('');
  renderRiskTimeline();

  const svg = document.getElementById('historySvg');
  const data = h.slice().reverse().map(d => d.risk);
  const W = 900, H = 220, padL = 44, padR = 14, padT = 16, padB = 26;
  const x = i => padL + i * (W - padL - padR) / (data.length - 1);
  const y = v => padT + (H - padT - padB) * (1 - v / 100);
  let grid = '';
  [0, 25, 50, 75, 100].forEach(g => { grid += `<line x1="${padL}" y1="${y(g)}" x2="${W - padR}" y2="${y(g)}" stroke="var(--line)" vector-effect="non-scaling-stroke" /><text x="${padL - 6}" y="${y(g) + 4}" text-anchor="end" font-size="11" fill="var(--muted)">${g}</text>`; });
  const bars = data.map((v, i) => {
    const st = getStatus(v), bw = (W - padL - padR) / data.length * 0.5;
    return `<rect x="${x(i) - bw / 2}" y="${y(v)}" width="${bw}" height="${H - padB - y(v)}" rx="3" fill="${statusColor(st)}" opacity="0.85" /><text x="${x(i)}" y="${y(v) - 6}" text-anchor="middle" font-size="11" fill="var(--text)">${v}</text>`;
  }).join('');
  const xlab = h.slice().reverse().map((d, i) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="var(--muted)">${d.date.slice(5)}</text>`).join('');
  svg.innerHTML = `${grid}<line x1="${padL}" y1="${y(70)}" x2="${W - padR}" y2="${y(70)}" stroke="var(--red)" stroke-dasharray="5 4" vector-effect="non-scaling-stroke" />${bars}${xlab}`;
}

/* ============ 예측 탭 (난수 → 추세 기반) ============ */
function renderPredictTab() {
  const p = patients.find(x => x.id === selectedPatientId), s = state[p.id];
  const t = s.trend.map(x => x.risk);
  const late = t.slice(-6).reduce((a, b) => a + b, 0) / 6;
  const early = t.slice(-12, -6).reduce((a, b) => a + b, 0) / 6;
  const slopePer6h = late - early;
  const pred = clamp(Math.round(s.risk + slopePer6h * 4), 0, 100);
  const delta = pred - s.risk;

  document.getElementById('predictPatientLabel').textContent = `${p.name} · ${p.room} · ${p.dx}`;
  document.getElementById('currentRiskPredict').textContent = s.risk + '%';
  document.getElementById('predictedRisk').textContent = pred + '%';
  document.getElementById('predictedRisk').style.color = statusColor(getStatus(pred));
  document.getElementById('slopeValue').textContent = `${slopePer6h >= 0 ? '+' : ''}${slopePer6h.toFixed(1)}`;
  document.getElementById('slopeValue').style.color = slopePer6h > 0 ? 'var(--red)' : slopePer6h < 0 ? 'var(--green)' : 'var(--muted)';

  document.getElementById('predictionText').innerHTML = delta > 5 ? '📈 악화 예상 — 조치 강화 필요' : delta < -5 ? '📉 개선 예상 — 치료 효과 있음' : '➡️ 유지 예상 — 지속 모니터링';
  document.getElementById('predictionDetail').textContent = `현재 ${s.risk}% → 24시간 뒤 ${pred}% (${delta >= 0 ? '+' : ''}${delta}%p). 6시간당 ${slopePer6h.toFixed(1)}%p 변화 추세.`;
}

/* ============ 체크리스트 (자동 연동 + 상태 유지) ============ */
const sirsDefs = [['체온 >38°C 또는 <36°C', v => v.temperature > 38 || v.temperature < 36], ['심박수 >90 bpm', v => v.heartRate > 90], ['호흡수 >20 /min', v => v.respRate > 20], ['백혈구 >12,000 또는 <4,000 /µL', v => v.wbc > 12 || v.wbc < 4]];
const qsofaDefs = [['의식 변화 (GCS <15)', v => v.gcs < 15], ['수축기 혈압 ≤100 mmHg', v => v.sysBloodPress <= 100], ['호흡수 ≥22 /min', v => v.respRate >= 22]];

function syncChecklist(id) {
  const v = {...state[id].vitals, ...state[id].labs};
  const prevManual = (state[id].checklist && state[id].checklist.manual) || {sirs: sirsDefs.map(() => false), qsofa: qsofaDefs.map(() => false)};
  state[id].checklist = {
    sirs: sirsDefs.map((d, i) => d[1](v) || !!prevManual.sirs[i]),
    qsofa: qsofaDefs.map((d, i) => d[1](v) || !!prevManual.qsofa[i]),
    manual: prevManual
  };
}

/* 수기로 체크한 항목만 공용 데이터베이스에 저장 — 다른 의료진 화면에도 실시간 반영됩니다 */
function saveChecklistToFirebase(id) {
  if (!fbReady || !fbDb) return;
  const m = state[id].checklist.manual;
  fbDb.ref(`${CHECKLIST_ROOT}/${id}`).set({manual: m, updatedBy: me.name, time: nowT()}).catch(err => console.warn('Firebase 체크리스트 저장 실패', err));
}

function startChecklistSync() {
  if (!fbReady || !fbDb || checklistListenerAttached) return;
  checklistListenerAttached = true;
  patients.forEach(p => {
    fbDb.ref(`${CHECKLIST_ROOT}/${p.id}`).on('value', snap => {
      const val = snap.val();
      if (!state[p.id] || !val || !val.manual) return;
      state[p.id].checklist = state[p.id].checklist || {};
      state[p.id].checklist.manual = val.manual;
      syncChecklist(p.id);
      if (p.id === selectedPatientId) renderChecklist(true);
    });
  });
}
function stopChecklistSync() {
  if (fbReady && fbDb) patients.forEach(p => fbDb.ref(`${CHECKLIST_ROOT}/${p.id}`).off());
  checklistListenerAttached = false;
}

function renderChecklist(force) {
  const id = selectedPatientId;
  if (!force && checklistRenderedFor === id) { updateChecklistScores(); return; }
  checklistRenderedFor = id;
  const v = {...state[id].vitals, ...state[id].labs}, c = state[id].checklist;
  document.getElementById('sirsChecklist').innerHTML = sirsDefs.map((d, i) => `<div class="checklist-item"><input type="checkbox" id="sirs${i}" ${c.sirs[i] ? 'checked' : ''} onchange="onCheck('sirs',${i},this.checked)" /><label for="sirs${i}">${d[0]} ${d[1](v) ? '<span class="auto-tag">자동</span>' : ''}</label></div>`).join('');
  document.getElementById('qsofaChecklist').innerHTML = qsofaDefs.map((d, i) => `<div class="checklist-item"><input type="checkbox" id="qsofa${i}" ${c.qsofa[i] ? 'checked' : ''} onchange="onCheck('qsofa',${i},this.checked)" /><label for="qsofa${i}">${d[0]} ${d[1](v) ? '<span class="auto-tag">자동</span>' : ''}</label></div>`).join('');
  updateChecklistScores();
}

function onCheck(group, i, checked) {
  const id = selectedPatientId, c = state[id].checklist;
  c[group][i] = checked;
  c.manual[group][i] = checked;
  updateChecklistScores();
  log('조치', `${id} 체크리스트 수정 (${group === 'sirs' ? 'SIRS' : 'qSOFA'} ${i + 1}번 · ${checked ? '체크' : '해제'})`);
  saveChecklistToFirebase(id);
}

function resetChecklist() {
  const id = selectedPatientId;
  state[id].checklist = {manual: {sirs: sirsDefs.map(() => false), qsofa: qsofaDefs.map(() => false)}};
  syncChecklist(id);
  renderChecklist(true);
  log('조치', `${selectedPatientId} 체크리스트 재설정`);
  saveChecklistToFirebase(id);
}

function updateChecklistScores() {
  const c = state[selectedPatientId].checklist;
  const sirs = c.sirs.filter(Boolean).length, qsofa = c.qsofa.filter(Boolean).length;
  document.getElementById('sirsScore').textContent = sirs;
  document.getElementById('qsofaScore').textContent = qsofa;
  const box = document.getElementById('judgmentBox');
  if (sirs >= 2 && qsofa >= 2) { box.innerHTML = '🚨 패혈증 고위험 — 즉시 임상의 보고'; box.style.color = 'var(--red)'; }
  else if (sirs >= 2) { box.innerHTML = '⚠️ 패혈증 의심 — 정밀 검사 필요'; box.style.color = 'var(--amber)'; }
  else if (qsofa >= 2) { box.innerHTML = '⚠️ qSOFA 고위험 — 장기부전 평가 필요'; box.style.color = 'var(--amber)'; }
  else { box.innerHTML = '✅ 현재 안정 — 지속 모니터링'; box.style.color = 'var(--green)'; }
}

/* ============ 메시지 ============ */
function sendMessage() {
  const input = document.getElementById('messageInput');
  const text = input.value.trim();
  if (!text) return;
  const p = patients.find(x => x.id === selectedPatientId);
  const payload = {doctor: `${me.name} · ${me.role}`, time: nowT(), ts: Date.now(), text, patient: `${p.name}/${p.room}`};
  input.value = '';
  log('소통', `메시지 전송 (${me.name})`);
  if (fbReady && fbDb) {
    /* 공용 데이터베이스에 저장 → 다른 컴퓨터/브라우저의 의료진도 즉시 확인 가능 */
    fbDb.ref(MESSAGES_PATH).push(payload).catch(err => console.warn('Firebase 메시지 기록 실패', err));
  } else {
    messages.push(payload);
    renderMessages();
  }
}

function renderMessages() {
  const el = document.getElementById('messageList');
  const note = document.getElementById('msgScopeNote');
  let list = messages;
  if (viewMode === 'mine') {
    const tags = new Set(visiblePatients().map(p => `${p.name}/${p.room}`));
    list = messages.filter(m => tags.has(m.patient));
  }
  if (note) { note.style.display = viewMode === 'mine' ? 'block' : 'none'; note.textContent = `👤 내 환자 모드 — 담당 환자에 관한 메시지 ${list.length}건만 표시 중 (전체 ${messages.length}건)`; }
  if (!list.length) { el.innerHTML = `<div class="empty">${viewMode === 'mine' && messages.length ? '담당 환자에 관한 메시지가 없습니다.' : '아직 주고받은 메시지가 없습니다. 아래에 입력해 시작하세요.'}</div>`; return; }
  el.innerHTML = list.map(m => `<div class="message-box"><div class="message-header"><span>${esc(m.doctor)} <span style="font-weight:400;color:var(--muted)">· ${esc(m.patient)}</span></span><span class="message-time">${esc(itemDT(m, m._key))}</span></div><div>${esc(m.text)}</div></div>`).join('');
  el.scrollTop = el.scrollHeight;
}

/* ============ 요약 & 보고서 ============ */
function summaryRows() {
  return visiblePatients().map(p => {
    const s = state[p.id], st = getStatus(s.risk), diff = s.risk - s.prevRisk;
    return {name: p.name, room: p.room, risk: s.risk, status: st, diff, reason: reasonsFor(s.vitals, s.labs)[0]};
  }).sort((a, b) => b.risk - a.risk);
}

function renderSummaryTab() {
  document.getElementById('reportDate').textContent = new Date().toLocaleString('ko-KR');
  const rows = summaryRows();
  document.getElementById('summaryScopeLabel').textContent = `환자 요약 (${viewMode === 'mine' ? `${me.name} 담당` : '전체'} ${rows.length}명)`;
  document.getElementById('countDanger').textContent = rows.filter(r => r.status === '위험').length + '명';
  document.getElementById('countWarn').textContent = rows.filter(r => r.status === '주의').length + '명';
  document.getElementById('countOk').textContent = rows.filter(r => r.status === '정상').length + '명';
  document.getElementById('reportSummaryBody').innerHTML = rows.map(r => `<tr><td><strong>${r.name}</strong></td><td>${r.room}</td><td>${r.risk}%</td><td><span class="badge ${statusClass(r.status)}">${r.status}</span></td><td>${r.diff > 0 ? '⬆️ +' + r.diff : r.diff < 0 ? '⬇️ ' + r.diff : '➡️ 0'}</td><td>${esc(r.reason)}</td></tr>`).join('');
}

function download(filename, content, type) {
  const blob = new Blob(['\ufeff' + content], {type});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function downloadReport() {
  const rows = summaryRows();
  const html = `<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><title>패혈증 모니터링 보고서</title><style>body{font-family:"Noto Sans KR",sans-serif;padding:32px;color:#1f2937}h1{font-size:20px}table{width:100%;border-collapse:collapse;font-size:13px;margin-top:12px}th,td{border:1px solid #e5e7eb;padding:8px;text-align:left}th{background:#f3f4f6}</style></head><body><h1>패혈증 조기 경고 시스템 — 일일 모니터링 보고서</h1><p>생성 일시: ${new Date().toLocaleString('ko-KR')}<br>범위: ${viewMode === 'mine' ? esc(me.name) + ' 담당 환자' : '전체 환자'} (${rows.length}명)<br>작성: 건양대 의료IT공학과 · 바이탈 사인 v5.5.0</p><p>위험 ${rows.filter(r => r.status === '위험').length}명 · 주의 ${rows.filter(r => r.status === '주의').length}명 · 정상 ${rows.filter(r => r.status === '정상').length}명</p><table><thead><tr><th>환자</th><th>병실</th><th>위험도</th><th>상태</th><th>변화</th><th>주요 원인</th></tr></thead><tbody>${rows.map(r => `<tr><td>${r.name}</td><td>${r.room}</td><td>${r.risk}%</td><td>${r.status}</td><td>${r.diff >= 0 ? '+' + r.diff : r.diff}</td><td>${r.reason}</td></tr>`).join('')}</tbody></table></body></html>`;
  download(`패혈증_보고서_${new Date().toISOString().slice(0, 10)}.html`, html, 'text/html;charset=utf-8');
  log('출력', '보고서 HTML 저장');
}

function downloadCsv() {
  const rows = summaryRows();
  const csv = ['환자,병실,위험도,상태,변화,주요원인'].concat(rows.map(r => `${r.name},${r.room},${r.risk},${r.status},${r.diff},"${r.reason}"`)).join('\n');
  download(`패혈증_요약_${new Date().toISOString().slice(0, 10)}.csv`, csv, 'text/csv;charset=utf-8');
  log('출력', '요약 CSV 내보내기');
}

function downloadAudit() {
  const csv = ['시간,의료진,구분,조치'].concat(auditLog.map(l => `${l.time},${l.user || '-'},${l.kind},"${l.action}"`)).join('\n');
  download(`감시로그_${new Date().toISOString().slice(0, 10)}.csv`, csv, 'text/csv;charset=utf-8');
}

/* ============ 감시로그 ============ */
function renderAuditTab() {
  const body = document.getElementById('auditTableBody');
  if (!body) return;
  if (!auditLog.length) { body.innerHTML = '<tr><td colspan="4" style="text-align:center;padding:20px;">기록 없음</td></tr>'; return; }
  body.innerHTML = auditLog.slice().reverse().map(l => `<tr><td>${l.time}</td><td>${esc(l.user || '-')}</td><td>${l.kind}</td><td>${esc(l.action)}</td></tr>`).join('');
}


/* ============ 내 환자만 보기 ============ */
function visiblePatients() {
  if (viewMode !== 'mine') return patients;
  return patients.filter(p => state[p.id] && state[p.id].assignedDoctor === me.name);
}
function setViewMode(mode) {
  if (mode === viewMode) return;
  viewMode = mode;
  store.set('vitalSign_viewMode_' + me.name, mode);
  log('설정', mode === 'mine' ? '내 환자만 보기로 전환' : '전체 환자 보기로 전환');
  checklistRenderedFor = null;
  renderAll();
}
function renderViewToggle() {
  const mine = patients.filter(p => state[p.id] && state[p.id].assignedDoctor === me.name).length;
  const a = document.getElementById('viewAllBtn'), m = document.getElementById('viewMineBtn');
  if (!a || !m) return;
  a.classList.toggle('on', viewMode === 'all');
  m.classList.toggle('on', viewMode === 'mine');
  a.setAttribute('aria-pressed', viewMode === 'all');
  m.setAttribute('aria-pressed', viewMode === 'mine');
  document.getElementById('viewAllCount').textContent = patients.length;
  document.getElementById('viewMineCount').textContent = mine;
  document.getElementById('patientListTitle').textContent = viewMode === 'mine' ? `내 담당 환자 (${mine}명)` : 'ICU 환자 우선순위';
  const note = document.getElementById('scopeNote');
  note.classList.toggle('show', viewMode === 'mine' && mine > 0);
  note.textContent = `👤 내 환자 모드 — ${me.name} 전공의 담당 환자 ${mine}명의 정보만 표시합니다. 알람 배지, 요약 보고서, 메시지도 담당 환자 기준입니다.`;
}

/* ============ 환자 안전 정보 배너 ============ */
function safetyChips(p) {
  const out = [];
  out.push(p.allergies.length ? `<span class="chip chip-danger">⚠️ 알레르기: ${p.allergies.map(esc).join(', ')}</span>` : '<span class="chip">알레르기 없음 (NKDA)</span>');
  out.push(`<span class="chip">⚖️ 체중 ${p.weight} kg</span>`);
  out.push(p.code === 'DNR' ? '<span class="chip chip-purple">🟣 DNR (심폐소생술 금지)</span>' : '<span class="chip">연명의료: 전체 처치</span>');
  (p.flags || []).forEach(f => out.push(`<span class="chip chip-amber">${esc(f)}</span>`));
  return out.join('');
}

/* ============ Hour-1 번들 ============
   위험 단계에 들어서는 순간을 Time Zero로 기록하고, 1시간 안에 끝내야 할 항목의
   완료 시각을 남깁니다. 시작 시각과 기록은 Firebase로 모든 의료진 화면에 공유됩니다. */
function emptyBundle() { return {t0: null, startedBy: '', auto: false, items: {}}; }

function bundleDefs(id) {
  const p = patients.find(x => x.id === id), s = state[id], v = s.vitals, lab = s.labs, b = s.bundle, map = mapOf(v);
  const first = b.items.lactate && b.items.lactate.value != null ? Number(b.items.lactate.value) : lab.lactate;
  const hypo = v.sysBloodPress < 90 || map < 65;
  const fluidReasons = [v.sysBloodPress < 90 ? 'SBP <90' : '', map < 65 ? 'MAP <65' : '', first >= 4 ? '젖산 ≥4' : ''].filter(Boolean);
  const overload = (p.flags || []).some(f => /심부전|신장/.test(f));
  const onPressor = ((emr[id] || {}).meds || []).some(m => /노르에피네프린|바소프레신|도파민/.test(m[0]));
  return [
    {key: 'lactate', label: '젖산 측정', sub: `최근 결과 ${lab.lactate} mmol/L (${agoText(lab.ts)})`, req: true, value: true, unit: 'mmol/L', hour: true},
    {key: 'culture', label: '혈액배양 채취 — 항생제 투여 전', sub: '2세트 이상 권장', req: true, hour: true},
    {key: 'abx', label: '광범위 항생제 투여', sub: p.allergies.length ? `⚠️ 알레르기: ${p.allergies.join(', ')} — 약제 선택 시 확인` : '알레르기 없음 (NKDA)', warn: p.allergies.length > 0, req: true, hour: true},
    {key: 'fluid', label: `정질액 30 mL/kg 투여 — ${(p.weight * 30).toLocaleString()} mL (${p.weight} kg 기준)`, sub: fluidReasons.length ? `적응증 해당: ${fluidReasons.join(', ')}${overload ? ' · 심부전/신장질환 — 투여 중 과부하 관찰' : ''}` : '현재 저혈압·젖산 ≥4 기준 미해당 — 필요 시 기록', req: hypo || first >= 4, hour: true},
    {key: 'pressor', label: '승압제 시작 — MAP 65 mmHg 이상 목표', sub: `수액 후에도 MAP <65이면 시작 · 현재 MAP ${map} mmHg${onPressor ? ' · EMR상 승압제 투여 중' : ''}`, req: map < 65, hour: true},
    {key: 'relactate', label: '젖산 재측정', sub: first > 2 ? `초기 젖산 ${first} mmol/L (>2) — 시작 후 2–4시간 안에 권장` : '초기 젖산 2 이하 — 필요 시 기록', req: first > 2, value: true, unit: 'mmol/L', hour: false}
  ];
}

function bundleStatus(id) {
  const s = state[id], b = s && s.bundle;
  if (!b || !b.t0) return {started: false};
  const hourItems = bundleDefs(id).filter(d => d.hour && (d.req || b.items[d.key]));
  const done = hourItems.filter(d => b.items[d.key]);
  const complete = hourItems.length > 0 && done.length === hourItems.length;
  const completeMs = complete ? Math.max(...done.map(d => b.items[d.key].ts)) - b.t0 : null;
  return {started: true, elapsed: Date.now() - b.t0, done: done.length, total: hourItems.length, complete, completeMs};
}

function fmtClock(ms) {
  const t = Math.max(0, Math.floor(ms / 1000)), h = Math.floor(t / 3600), m = Math.floor(t % 3600 / 60), sec = t % 60;
  const p2 = n => String(n).padStart(2, '0');
  return h ? `${h}:${p2(m)}:${p2(sec)}` : `${p2(m)}:${p2(sec)}`;
}
function bundleChipText(bs) { return bs.elapsed > BUNDLE_WINDOW ? '⏱ 번들 초과' : `⏱ ${Math.floor(bs.elapsed / 60000)}분`; }

function bundleClock(id) {
  const st = bundleStatus(id);
  if (st.complete) {
    const inTime = st.completeMs <= BUNDLE_WINDOW;
    return {text: `완료 ${Math.max(0, Math.round(st.completeMs / 60000))}분`, sub: inTime ? '1시간 안에 필수 항목 완료' : '필수 항목 완료 (1시간 초과)', pct: 100, color: inTime ? 'var(--green)' : 'var(--amber)'};
  }
  if (st.elapsed <= BUNDLE_WINDOW) {
    return {text: fmtClock(st.elapsed), sub: `남은 시간 ${fmtClock(BUNDLE_WINDOW - st.elapsed)} · 필수 ${st.done}/${st.total} 완료`, pct: st.elapsed / BUNDLE_WINDOW * 100, color: st.elapsed > 45 * 60000 ? 'var(--amber)' : 'var(--green)'};
  }
  return {text: `+${fmtClock(st.elapsed - BUNDLE_WINDOW)}`, sub: `1시간 초과 · 필수 ${st.done}/${st.total} 완료`, pct: 100, color: 'var(--red)'};
}

function maybeAutoStartBundle(id) {
  const s = state[id];
  if (!s || s.bundle.t0 || getStatus(s.risk) !== '위험') return;
  if (s._autoTry && Date.now() - s._autoTry < 30000) return;
  s._autoTry = Date.now();
  startBundle(id, true);
}

function startBundle(id, auto) {
  const s = state[id];
  if (!s || s.bundle.t0) return;
  const ts = Date.now(), startedBy = auto ? '자동 (위험 단계 진입)' : me.name;
  s.bundle = {t0: ts, startedBy, auto: !!auto, items: s.bundle.items || {}};
  const msg = `${id} Hour-1 번들 시작 — ${startedBy}`;
  if (fbReady && fbDb) {
    /* 여러 의료진 화면이 동시에 자동 시작해도 Time Zero는 가장 먼저 기록된 한 번만 저장 */
    fbDb.ref(`${BUNDLE_ROOT}/${id}`).transaction(cur => {
      if (cur && cur.t0) return;
      return {t0: ts, startedBy, auto: !!auto, items: (cur && cur.items) || {}};
    }, (err, committed) => {
      if (err) console.warn('Firebase 번들 시작 기록 실패', err);
      else if (committed) log('조치', msg);
    });
  } else {
    log('조치', msg);
  }
  if (!auto) renderAll();
}

function recordBundleItem(key) {
  const id = selectedPatientId, s = state[id], b = s.bundle;
  if (!b.t0) return;
  const def = bundleDefs(id).find(d => d.key === key);
  const item = {ts: Date.now(), by: me.name, role: me.role};
  if (def.value) {
    const inp = document.getElementById('bval-' + key);
    const n = parseFloat(inp && inp.value);
    if (!isFinite(n) || n < 0 || n > 30) { if (inp) { inp.style.borderColor = 'var(--red)'; inp.placeholder = '값 입력'; inp.focus(); } return; }
    item.value = Math.round(n * 10) / 10;
    item.prevLab = {lactate: s.labs.lactate, ts: s.labs.ts};
    applyLactate(id, item.value, item.ts);
  }
  b.items[key] = item;
  const name = def.label.split(' — ')[0];
  log('조치', `${id} 번들 · ${name} 완료${item.value != null ? ` (${item.value} mmol/L)` : ''} — ${me.name}`);
  if (key === 'abx' && !b.items.culture) log('경고', `${id} 혈액배양 기록 없이 항생제 투여 기록됨`);
  if (fbReady && fbDb) fbDb.ref(`${BUNDLE_ROOT}/${id}/items/${key}`).set(item).catch(err => console.warn('Firebase 번들 항목 기록 실패', err));
  renderAll();
}

function undoBundleItem(key) {
  const id = selectedPatientId, s = state[id], it = s.bundle.items[key];
  if (!it || it.by !== me.name) return;
  if (!confirm('이 기록을 취소할까요?')) return;
  if (it.prevLab && s.labs.ts === it.ts) { s.labs.lactate = it.prevLab.lactate; s.labs.ts = it.prevLab.ts; s.risk = calcRisk(s.vitals, s.labs); }
  delete s.bundle.items[key];
  log('조치', `${id} 번들 항목 기록 취소 (${key})`);
  if (fbReady && fbDb) fbDb.ref(`${BUNDLE_ROOT}/${id}/items/${key}`).remove().catch(err => console.warn('Firebase 번들 항목 취소 실패', err));
  renderAll();
}

function resetBundle() {
  const id = selectedPatientId, s = state[id];
  if (!confirm('이 환자의 번들 기록을 모두 지우고 초기화할까요?\n위험 단계인 환자는 지금 시각으로 다시 시작됩니다.')) return;
  s.bundle = emptyBundle();
  s._autoTry = 0;
  log('조치', `${id} Hour-1 번들 초기화 — ${me.name}`);
  if (fbReady && fbDb) fbDb.ref(`${BUNDLE_ROOT}/${id}`).remove().catch(err => console.warn('Firebase 번들 초기화 실패', err));
  maybeAutoStartBundle(id);
  renderAll();
}

function applyLactate(id, value, ts) {
  const s = state[id];
  if (s.labs.ts && ts < s.labs.ts) return;
  s.labs.lactate = value;
  s.labs.ts = ts;
  s.risk = calcRisk(s.vitals, s.labs);
}

function renderBundle() {
  const el = document.getElementById('bundleCard');
  if (!el) return;
  const id = selectedPatientId, s = state[id], b = s.bundle;
  /* 자동 갱신으로 다시 그려도 입력 중이던 값과 커서가 사라지지 않도록 보존 */
  const keep = {}, focused = document.activeElement && el.contains(document.activeElement) ? document.activeElement.id : null;
  if (el.dataset.pid === id) el.querySelectorAll('input[id^="bval-"]').forEach(i => { keep[i.id] = i.value; });
  el.dataset.pid = id;

  if (!b.t0) {
    el.innerHTML = `<div class="bundle-head"><div><h3 style="margin:0">⏱ 패혈증 Hour-1 번들</h3><p class="note" style="margin:6px 0 0">위험 단계에 들어서면 자동으로 시작됩니다. 임상적으로 패혈증이 의심되면 직접 시작하세요.</p></div><button class="btn btn-danger" onclick="startBundle(selectedPatientId, false)">번들 시작</button></div>`;
    return;
  }
  const defs = bundleDefs(id);
  const rows = defs.map(d => {
    const it = b.items[d.key];
    const cls = it ? 'done' : d.req ? '' : 'na';
    const mark = it ? '✓' : d.req ? '○' : '–';
    let act;
    if (it) {
      const mins = Math.round((it.ts - b.t0) / 60000), late = d.hour && it.ts - b.t0 > BUNDLE_WINDOW;
      act = `<div class="b-stamp"><span class="${late ? 'b-late' : ''}">+${Math.max(0, mins)}분</span>${it.value != null ? ` · <strong>${it.value} ${d.unit}</strong>` : ''}<br>${esc(fmtDT(it.ts))} · ${esc(it.by)}</div>${it.by === me.name ? `<button class="link-btn" onclick="undoBundleItem('${d.key}')">취소</button>` : ''}`;
    } else {
      act = (d.value ? `<input type="number" step="0.1" min="0" id="bval-${d.key}" placeholder="${d.unit}" aria-label="${d.label} 결과" onkeydown="if(event.key==='Enter')recordBundleItem('${d.key}')" />` : '')
        + `<button class="btn ${d.req ? 'btn-primary' : 'btn-ghost'}" onclick="recordBundleItem('${d.key}')">${d.value ? '결과 기록' : '완료 기록'}</button>`;
    }
    return `<div class="b-item ${cls}"><div class="b-mark">${mark}</div><div><div class="b-label">${esc(d.label)}</div><div class="b-sub ${d.warn && !it ? 'warn' : ''}">${esc(d.sub)}</div></div><div class="b-act">${act}</div></div>`;
  }).join('');
  const orderWarn = b.items.abx && (!b.items.culture || b.items.culture.ts > b.items.abx.ts)
    ? `<div class="bundle-warn">⚠️ 혈액배양 ${b.items.culture ? '채취가 항생제 투여보다 늦게' : '기록 없이 항생제가'} 기록되었습니다. 배양 결과 해석에 영향이 있을 수 있습니다.</div>` : '';

  el.innerHTML = `<div class="bundle-head"><div><h3 style="margin:0">⏱ 패혈증 Hour-1 번들</h3><p class="note" style="margin:6px 0 0">Time Zero ${esc(fmtDT(b.t0))} · ${esc(b.startedBy)}</p></div><div class="bundle-clock"><div class="bundle-timer" id="bundleTimer">--:--</div><div class="bundle-timer-sub" id="bundleTimerSub">-</div></div></div>
    <div class="bundle-bar"><div id="bundleBar"></div></div>
    <div class="bundle-items">${rows}</div>${orderWarn}
    <div class="bundle-foot"><span>○ 필수 · – 현재 기준 미해당 · 기록은 모든 의료진 화면에 공유됩니다</span><button class="btn btn-ghost" onclick="resetBundle()">↺ 기록 초기화</button></div>`;

  Object.keys(keep).forEach(k => { const i = document.getElementById(k); if (i) i.value = keep[k]; });
  if (focused) { const f = document.getElementById(focused); if (f) f.focus(); }
  tickBundles();
}

/* 1초마다 타이머 숫자와 환자 목록의 경과 표시만 갱신 (전체를 다시 그리지 않음) */
function tickBundles() {
  const t = document.getElementById('bundleTimer');
  if (t && state[selectedPatientId] && state[selectedPatientId].bundle.t0) {
    const c = bundleClock(selectedPatientId);
    t.textContent = c.text;
    t.style.color = c.color;
    document.getElementById('bundleTimerSub').textContent = c.sub;
    const bar = document.getElementById('bundleBar');
    bar.style.width = c.pct + '%';
    bar.style.background = c.color;
  }
  document.querySelectorAll('.bundle-chip[data-pid]').forEach(ch => {
    const bs = bundleStatus(ch.dataset.pid);
    if (!bs.started) return;
    ch.textContent = bundleChipText(bs);
    ch.classList.toggle('over', bs.elapsed > BUNDLE_WINDOW);
  });
}

function startBundleSync() {
  if (!fbReady || !fbDb || bundleListenerAttached) return;
  bundleListenerAttached = true;
  patients.forEach(p => {
    fbDb.ref(`${BUNDLE_ROOT}/${p.id}`).on('value', snap => {
      const val = snap.val(), s = state[p.id];
      if (!s) return;
      /* 24시간 지난 번들은 지난 에피소드로 보고 정리 */
      if (val && val.t0 && Date.now() - val.t0 > 24 * 3600e3) { snap.ref.remove().catch(() => {}); return; }
      if (!val || !val.t0) {
        const pendingLocal = s.bundle.t0 && s._autoTry && Date.now() - s._autoTry < 30000;
        if (!pendingLocal) { s.bundle = emptyBundle(); maybeAutoStartBundle(p.id); }
      } else {
        s.bundle = {t0: val.t0, startedBy: val.startedBy || '', auto: !!val.auto, items: val.items || {}};
        ['lactate', 'relactate'].forEach(k => { const it = s.bundle.items[k]; if (it && it.value != null) applyLactate(p.id, Number(it.value), it.ts); });
      }
      if (p.id === selectedPatientId) { renderBundle(); renderVitals(s); }
      renderPatientList();
    }, err => console.warn('Firebase 번들 동기화 실패', err));
  });
}
function stopBundleSync() {
  if (fbReady && fbDb) patients.forEach(p => fbDb.ref(`${BUNDLE_ROOT}/${p.id}`).off());
  bundleListenerAttached = false;
}

/* ============ 동작 ============ */
function selectPatient(id) {
  selectedPatientId = id;
  checklistRenderedFor = null;
  const p = patients.find(x => x.id === id);
  log('조회', `${p.name} (${id}) 환자 조회`);
  renderAll();
}

function refreshData() {
  patients.forEach(p => {
    const s = state[p.id];
    s.prevRisk = s.risk;
    s.prevVitals = {...s.vitals};
    const sbp = jitter(s.vitals.sysBloodPress, 'sysBloodPress');
    s.vitals = {temperature: jitter(s.vitals.temperature, 'temperature'), heartRate: jitter(s.vitals.heartRate, 'heartRate'), respRate: jitter(s.vitals.respRate, 'respRate'), sysBloodPress: sbp, dbp: Math.min(jitter(s.vitals.dbp, 'dbp'), sbp - 15), spO2: jitter(s.vitals.spO2, 'spO2'), gcs: s.vitals.gcs};
    s.risk = calcRisk(s.vitals, s.labs);
    s.trend.push({...s.vitals, risk: s.risk});
    if (s.trend.length > 24) s.trend.shift();
    s.history[0].risk = s.risk;
    if (Math.abs(s.risk - s.prevRisk) >= 5 || getStatus(s.risk) !== getStatus(s.prevRisk)) {
      s.riskTimeline.push({time: nowT(), risk: s.risk, driver: reasonsFor(s.vitals, s.labs)[0]});
      if (s.riskTimeline.length > 40) s.riskTimeline.shift();
    }
    syncChecklist(p.id);
    evaluateAlarms(p.id, false);
    maybeAutoStartBundle(p.id);
  });
  checklistRenderedFor = null;
  updateTime();
  renderAll();
}

function toggleAuto() {
  const on = document.getElementById('autoRefresh').checked;
  if (on) { autoTimer = setInterval(refreshData, 10000); log('설정', '자동 갱신 켜짐 (10초)'); }
  else { clearInterval(autoTimer); autoTimer = null; log('설정', '자동 갱신 꺼짐'); }
}

function updateTime() { document.getElementById('updateTime').textContent = `마지막 업데이트: ${new Date().toLocaleString('ko-KR')}`; }

function toggleTheme() {
  document.body.classList.toggle('dark');
  const dark = document.body.classList.contains('dark');
  document.getElementById('themeBtn').textContent = dark ? '☀️ 라이트모드' : '🌙 다크모드';
  drawTrendChart();
  renderHistoryTab();
}

function renderAll() {
  renderViewToggle();
  const vis = visiblePatients();
  document.body.classList.toggle('no-my-patients', !vis.length);
  if (!vis.length) { renderGlobalAlarmBadge(); return; }
  if (!vis.some(p => p.id === selectedPatientId)) {
    selectedPatientId = vis.slice().sort((a, b) => state[b.id].risk - state[a.id].risk)[0].id;
    checklistRenderedFor = null;
  }
  renderPatientList();
  renderDashboard();
  renderChartTab();
  renderHistoryTab();
  renderPredictTab();
  renderChecklist(false);
  renderSummaryTab();
  renderMessages();
  renderAuditTab();
  renderGlobalAlarmBadge();
}

/* 로그인 후 init()이 실행됩니다 */
document.getElementById('doctorSelect').focus();
</script>
</body>
</html>
