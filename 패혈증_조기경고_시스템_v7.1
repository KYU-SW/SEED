function startRealTimeSync() {
  if (!fbReady || !fbDb || auditListenerAttached) return;
  auditListenerAttached = true;
  const ref = fbDb.ref(AUDIT_PATH).limitToLast(300);
  ref.on('child_added', snap => {
    const key = snap.key, val = snap.val();
    if (!val || auditLog.some(l => l._key === key)) return;
    auditLog.push({...val, _key: key});
    if (auditLog.length > 300) auditLog.shift();
    renderAuditTab();
  });
}
function stopRealTimeSync() {
  if (fbReady && fbDb) fbDb.ref(AUDIT_PATH).off('child_added');
  auditListenerAttached = false;
}

