<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>바이탈 사인 v5.5.0</title>
<style>
:root {
  --bg: #f5f7fb; --panel: #fff; --text: #1f2937; --muted: #6b7280; --line: #e5e7eb; --soft: #f3f4f6;
  --blue: #2563eb; --green: #10b981; --amber: #f59e0b; --red: #dc2626; --purple: #7c3aed;
}
body.dark {
  --bg: #111827; --panel: #1f2937; --text: #f9fafb; --muted: #9ca3af; --line: #374151; --soft: #273449;
  --blue: #60a5fa; --green: #34d399; --amber: #fbbf24; --red: #f87171; --purple: #a78bfa;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Sans KR", sans-serif; }
.container { max-width: 1780px; margin: auto; padding: 20px; }
.header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; border-bottom: 2px solid var(--line); padding-bottom: 16px; margin-bottom: 18px; }
.header h1 { font-size: 27px; margin: 0 0 6px; }
.header p { margin: 0; color: var(--muted); font-size: 14px; }
.header-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
button, input, select { font: inherit; }
.btn { border: 1px solid var(--line); background: var(--panel); color: var(--text); padding: 8px 11px; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 700; }
.btn:hover { filter: brightness(.97); }
.btn:focus-visible, .tab-btn:focus-visible, .tab:focus-visible, .patient-button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
.btn-primary { background: var(--blue); border-color: var(--blue); color: white; }
.btn-success { background: var(--green); border-color: var(--green); color: white; }
.btn-danger { background: var(--red); border-color: var(--red); color: white; }
.btn-ghost { background: var(--soft); }
.auto-chip { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); border: 1px solid var(--line); background: var(--panel); border-radius: 8px; padding: 7px 10px; }
.unack-badge { font-size: 12px; font-weight: 800; padding: 7px 12px; border-radius: 8px; background: var(--red); color: #fff; }
.unack-badge.zero { background: var(--soft); color: var(--muted); border: 1px solid var(--line); }
.alarm-actions { display: flex; justify-content: flex-end; margin-top: 6px; }
.ack-btn { border: none; background: transparent; color: var(--blue); font-size: 10px; font-weight: 800; cursor: pointer; padding: 0; }
.alarm.acked { opacity: .5; }
.acked-tag { font-size: 10px; font-weight: 700; color: var(--muted); }
.alarm-elapsed { font-size: 10px; color: var(--muted); margin: 4px 0 0; }
.alarm-elapsed.stale-text { color: var(--red); font-weight: 800; }
.alarm.stale { border-left-width: 5px; animation: fbPulse 1.6s infinite; }
@keyframes fbPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(220,38,38,.35); } 50% { box-shadow: 0 0 0 5px rgba(220,38,38,0); } }
.fb-status { display: inline-block; margin-top: 6px; font-size: 11px; font-weight: 800; padding: 4px 9px; border-radius: 6px; background: var(--soft); border: 1px solid var(--line); color: var(--muted); }
.fb-status.ok { color: var(--green); border-color: var(--green); }
.fb-status.warn { color: var(--amber); border-color: var(--amber); }
.fb-status.fail { color: var(--red); border-color: var(--red); }
.intervention-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
.intervention-list { max-height: 220px; overflow-y: auto; }
.intervention-item { display: flex; gap: 8px; align-items: center; background: var(--soft); border-left: 3px solid var(--blue); border-radius: 6px; padding: 8px 10px; margin-top: 6px; font-size: 11px; flex-wrap: wrap; }
.intervention-time { color: var(--muted); min-width: 60px; }
.intervention-label { font-weight: 800; }
.intervention-doctor { color: var(--muted); margin-left: auto; }
.assignment-box { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font-size: 11px; margin-top: 8px; }
.assignment-box select { border: 1px solid var(--line); background: var(--panel); color: var(--text); border-radius: 6px; padding: 5px 7px; font-size: 11px; }
.assignment-label { color: var(--muted); font-weight: 700; }
.timeline-list { max-height: 260px; overflow-y: auto; }
.timeline-item { display: flex; gap: 10px; align-items: center; padding: 8px 10px; border-left: 3px solid var(--line); background: var(--soft); border-radius: 6px; margin-top: 6px; font-size: 12px; }
.timeline-time { color: var(--muted); min-width: 70px; }
.timeline-risk { font-weight: 800; min-width: 44px; }
.modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 999; padding: 20px; }
.modal-box { background: var(--panel); border-radius: 12px; padding: 20px; max-width: 560px; width: 100%; max-height: 82vh; overflow-y: auto; box-shadow: 0 20px 50px rgba(0,0,0,.35); }
.modal-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 6px; }
.modal-head h3 { margin: 0; }
.unack-modal-list { display: flex; flex-direction: column; gap: 8px; margin-top: 10px; }
.unack-modal-item { background: var(--soft); border-left: 4px solid var(--red); border-radius: 8px; padding: 10px 12px; font-size: 12px; }
.unack-modal-item .um-top { display: flex; justify-content: space-between; font-weight: 800; margin-bottom: 4px; }
.unack-modal-item .um-actions { display: flex; gap: 6px; margin-top: 6px; }
.tab-nav { display: flex; gap: 8px; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 8px; margin-bottom: 16px; flex-wrap: wrap; }
.tab-btn { border: 1px solid transparent; background: transparent; color: var(--text); padding: 8px 13px; border-radius: 6px; cursor: pointer; font-size: 12px; font-weight: 700; }
.tab-btn.active { background: var(--blue); color: white; border-color: var(--blue); }
