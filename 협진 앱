  consults.forEach(q => { members.add(q.from); members.add(q.to); });
  actions.forEach(a => members.add(a.owner));
  return {...c, status: st.status || c.status, finalDx: st.finalDx || c.finalDx, clue: st.clue || c.clue, lesson: st.lesson || c.lesson,
    closedAt: st.closedAt || c.closedAt, depts: st.depts || c.depts, journey: c.journey || [], excluded: c.excluded || [], tests: c.tests || [],
    phenos, cands, thread, actions, consults, members: [...members].filter(Boolean)};
}
function allCases() { return baseCases().map(mergeCase); }
function getCase(id) { const b = baseCases().find(c => c.id === id); return b ? mergeCase(b) : null; }

/* ---------- 점수 계산 ---------- */
function candScore(cd) {
  const lv = Object.values(cd.votes).map(v => v.level);
  if (!lv.length) return {pct: null, n: 0, agree: null};
  const pct = Math.round(lv.reduce((a, b) => a + b, 0) / lv.length / 3 * 100);
  const spread = Math.max(...lv) - Math.min(...lv);
  return {pct, n: lv.length, agree: lv.length < 2 ? null : spread === 0 ? 'ok' : spread === 1 ? 'mid' : 'split'};
}
function sortedCands(c) { return c.cands.map(cd => ({...cd, sc: candScore(cd)})).sort((a, b) => (b.sc.pct ?? -1) - (a.sc.pct ?? -1) || b.sc.n - a.sc.n); }
function pctColor(p) { return p == null ? 'var(--muted)' : p >= 67 ? 'var(--purple)' : p >= 40 ? 'var(--blue)' : 'var(--muted)'; }
function agreeTag(a) { return a === 'ok' ? '<span class="agree ok">의견 일치</span>' : a === 'mid' ? '<span class="agree mid">대체로 일치</span>' : a === 'split' ? '<span class="agree split">의견 갈림 · 토론 필요</span>' : ''; }

/* 증상 겹침 기반 질환 매칭 — 핵심 소견 가중치 2, 나머지 1 */
function matchDiseases(terms) {
  const set = new Set(terms), known = terms.filter(t => TERM_CAT[t]);
  return KB.map(d => {
    const feats = [...d.core.map(t => [t, 2]), ...d.other.map(t => [t, 1])];
    const total = feats.reduce((a, [, w]) => a + w, 0);
    const hit = feats.filter(([t]) => set.has(t));
    const recall = hit.reduce((a, [, w]) => a + w, 0) / total;
    const precision = known.length ? hit.length / known.length : 0;
    return {d, score: Math.round(100 * (0.65 * recall + 0.35 * precision)), hit: hit.map(([t]) => t), missingCore: d.core.filter(t => !set.has(t))};
  }).filter(m => m.hit.length).sort((a, b) => b.score - a.score).slice(0, 5);
}
function similarCases(c) {
  const set = new Set(c.phenos.map(p => p.t));
  return allCases().filter(x => x.status === 'done' && x.id !== c.id).map(x => {
    const xs = x.phenos.map(p => p.t), common = xs.filter(t => set.has(t));
    return {x, common, j: common.length / new Set([...set, ...xs]).size};
  }).filter(s => s.common.length).sort((a, b) => b.j - a.j).slice(0, 3);
}
function odysseyYears(c) { return (c.status === 'done' && c.closedAt ? new Date(c.closedAt).getFullYear() : YEAR) - c.onsetYear; }
function slaInfo(q) {
  if (q.status === 'replied') return {text: `회신 완료 · ${ago(q.replyTs)}`, over: false};
  const left = q.ts + URG_H[q.urgency] * H - Date.now(), h = Math.ceil(Math.abs(left) / H);
  return left >= 0 ? {text: `회신 기한까지 ${h}시간`, over: false} : {text: `회신 기한 ${h}시간 초과`, over: true};
}
</script>
<script>
