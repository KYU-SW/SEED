}
function parseLines(v, n) { return v.split('\n').map(l => l.split('|').map(s => s.trim())).filter(a => a[0]).map(a => { while (a.length < n) a.push(''); return a.slice(0, n); }); }
function saveCase() {
  const g = id => document.getElementById(id).value.trim();
  const err = document.getElementById('nfErr');
  const title = g('nfTitle'), question = g('nfQ');
  if (!title || !question) { err.textContent = '주 호소 요약과 협진 질문은 필수입니다.'; return; }
  const allText = ['nfTitle', 'nfSummary', 'nfQ', 'nfJourney', 'nfEx', 'nfTests'].map(g).join('\n');
  const found = PII.filter(([re]) => re.test(allText)).map(([, l]) => l);
  if (found.length) { err.textContent = `🔒 식별정보로 보이는 내용이 있습니다: ${found.join(', ')}. 지우고 다시 등록하세요.`; return; }
  if (!document.getElementById('nfPrivacy').checked) { err.textContent = '식별정보 미포함 확인에 체크하세요.'; return; }
  const d = new Date(), prefix = `RC-${String(d.getFullYear()).slice(2)}${p2(d.getMonth() + 1)}-`;
  let n = baseCases().filter(c => c.id.startsWith(prefix)).length + 1;
  while (baseCases().some(c => c.id === prefix + p2(n))) n++;
  const id = prefix + p2(n);
  const onset = Math.min(YEAR, Math.max(1950, Number(g('nfOnset')) || YEAR));
  put(`cases/${id}`, {status: 'open', urgency: g('nfUrg'), owner: me.name, createdAt: Date.now(), title, age: g('nfAge'), sex: g('nfSex'), onsetYear: onset,
    summary: g('nfSummary'), question, phenos: formPhenos.slice(), journey: parseLines(g('nfJourney'), 3), excluded: parseLines(g('nfEx'), 2), tests: parseLines(g('nfTests'), 2)});
  post(id, '질문', question);
  log('등록', `${id} 새 케이스 등록`);
  closeModal();
  caseFilter = 'active';
  selectedCaseId = id;
  goTab('board');
  renderAll();
  toast(`${id} 케이스를 등록했습니다 — 증상 매칭 결과를 확인하세요`);
}

