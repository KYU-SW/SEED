}
function resetDemo() {
  if (!confirm('모든 의료진이 추가한 공유 기록(케이스, 의견, 요청, 회의)을 지우고 처음 상태로 되돌릴까요?')) return;
  remote = {};
  saveLocal();
  if (fbReady && fbDb) fbDb.ref(ROOT).remove().catch(() => toast('초기화 실패 — 권한을 확인하세요'));
  log('시연', '시연 데이터 초기화');
