function saveMdt() {
  const caseIds = [...document.querySelectorAll('#mdCases input:checked')].map(i => i.value);
  const attendees = [...document.querySelectorAll('#mdAtt input:checked')].map(i => i.value);
  if (!caseIds.length) { document.getElementById('mdErr').textContent = '안건 케이스를 하나 이상 선택하세요.'; return; }
  const target = document.getElementById('mdTarget').value;
  let m;
  if (target) {
    const old = allMdts().find(x => x.id === target);
    m = {...old, caseIds: [...new Set([...old.caseIds, ...caseIds])], attendees: [...new Set([...old.attendees, ...attendees])]};
  } else {
    const when = new Date(document.getElementById('mdWhen').value).getTime();
    if (!when) { document.getElementById('mdErr').textContent = '일시를 입력하세요.'; return; }
    m = {id: uid(), title: document.getElementById('mdTitle').value.trim() || '다학제 회의', when, mode: document.getElementById('mdMode').value, caseIds, attendees, status: 'planned', createdBy: me.name};
  }
  const {id, ...rest} = m;
  put(`mdt/${id}`, rest);
  caseIds.forEach(cid => {
    const c = getCase(cid);
    if (c.status === 'open') put(`status/${cid}`, {status: 'mdt'});
    post(cid, '요청', `📅 다학제 회의 안건 등록: ${m.title} (${fmtDT(m.when)})`);
  });
  log('회의', `${m.title} — 안건 ${caseIds.join(', ')}`);
  closeModal();
  toast('회의 안건에 등록했습니다');
}
