function saveVariantNote(gene) {
  const note=(document.getElementById('variantNote').value||'').trim(); if(!note){toast('검토 의견을 입력하세요');return;}
  post(selectedCaseId,'의견',`[유전체 ${gene}] ${note}`); log('유전체',`${selectedCaseId} ${gene} 변이 검토 의견`); closeModal(); toast('유전체 검토 의견을 협진 토론에 남겼습니다');
}
function openGeneticsForCase(caseId) { selectedCaseId=caseId; goTab('genetics'); renderGeneticsWorkspace(); }
function openVideoForCase(caseId) { selectedCaseId=caseId; goTab('video'); renderVideoWorkspace(); }
function renderVideoWorkspace() {
  const root=document.getElementById('videoWorkspace'); if(!root||!booted) return;
  const c=currentCaseOrDefault(); if(!c) return;
  if(!videoJoined){
    root.innerHTML=`<div class="prejoin"><div class="card"><div style="font-size:42px">🎥</div><h2 style="font-size:22px;margin:8px 0">희귀질환 영상 협진</h2><p class="note">${esc(c.id)} · ${esc(c.title)} · 참가 예정 ${Math.max(4,c.members.length)}명</p><div class="prejoin-preview"><div style="font-size:30px">📹</div><b>카메라 사전 점검</b><span style="font-size:11px">현재 버전은 안전한 시연용 협진룸입니다. 실제 원격 통화는 WebRTC/Jitsi 서버 연결이 필요합니다.</span></div><div class="row" style="justify-content:center;margin-top:14px"><button class="btn btn-primary" onclick="joinVideoRoom()">협진룸 입장</button><button class="btn" onclick="goTab('genetics')">유전체 자료 먼저 보기</button></div></div></div>`; return;
  }
  const people=[['김서진','소아신경과'],['박도윤','진단검사의학과'],['최유나','심장내과'],['정하람','이비인후과']];
  root.innerHTML=`<div class="gen-toolbar"><div><h2 style="margin:0;font-size:20px">🎥 영상 협진 · ${esc(c.id)}</h2><p class="note">유전체 변이·가계도·임상정보를 동시에 보면서 공동 판독합니다.</p></div><div class="row"><button class="btn" onclick="goTab('genetics')">🧬 유전체 화면</button><button class="btn" onclick="selectCase('${c.id}')">🧩 케이스 보드</button></div></div><div class="video-shell"><div><div class="video-grid">${people.map((p,i)=>`<div class="video-tile"><div class="video-avatar">${esc(p[0].slice(-1))}</div><span class="video-name">${esc(p[0])} · ${esc(p[1])}</span><span class="video-state">${i===0?'발표 중':'연결됨'}</span></div>`).join('')}</div><div class="video-controls"><button class="control-btn ${videoMic?'':'off'}" onclick="toggleVideoMic()" title="마이크">${videoMic?'🎙️':'🔇'}</button><button class="control-btn ${videoCam?'':'off'}" onclick="toggleVideoCam()" title="카메라">${videoCam?'📹':'🚫'}</button><button class="control-btn ${videoSharing?'share-on':''}" onclick="toggleScreenShare()" title="화면 공유">🖥️</button><button class="btn btn-danger" onclick="leaveVideoRoom()">☎ 나가기</button></div></div><div class="card"><h3>협진 채팅 · 기록</h3><div class="chat-stream" id="videoChatStream">${videoMessages.map((m,i)=>`<div class="chat-msg ${m.startsWith('나:')?'me':''}">${esc(m)}</div>`).join('')}</div><div class="row" style="margin-top:10px"><input id="videoChatInput" class="field grow" placeholder="의견 입력" onkeydown="if(event.key==='Enter')sendVideoMessage()"><button class="btn btn-primary" onclick="sendVideoMessage()">전송</button></div><div class="clinical-callout" style="margin-top:12px"><b>현재 공유 자료</b><br>${esc(getGenomicVariants(c)[0].gene)} 변이 근거 · 가계도 · 감별진단 보드</div></div></div>`;
}
function joinVideoRoom(){ videoJoined=true; log('영상 협진',`${selectedCaseId} 영상 협진 입장`); renderVideoWorkspace(); }
function leaveVideoRoom(){ videoJoined=false; videoSharing=false; log('영상 협진',`${selectedCaseId} 영상 협진 퇴장`); renderVideoWorkspace(); }
function toggleVideoMic(){ videoMic=!videoMic; renderVideoWorkspace(); toast(videoMic?'마이크를 켰습니다':'마이크를 껐습니다'); }
function toggleVideoCam(){ videoCam=!videoCam; renderVideoWorkspace(); toast(videoCam?'카메라를 켰습니다':'카메라를 껐습니다'); }
async function toggleScreenShare(){
  if(videoSharing){videoSharing=false;renderVideoWorkspace();toast('화면 공유를 종료했습니다');return;}
  try{
    if(navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia){ const stream=await navigator.mediaDevices.getDisplayMedia({video:true}); videoSharing=true; stream.getVideoTracks()[0].addEventListener('ended',()=>{videoSharing=false;renderVideoWorkspace();}); renderVideoWorkspace(); toast('화면 공유를 시작했습니다'); }
    else { videoSharing=true; renderVideoWorkspace(); toast('브라우저 시연 모드로 화면 공유 상태를 표시합니다'); }
  }catch(e){ toast('화면 공유가 취소되었거나 브라우저에서 허용되지 않았습니다'); }
}
function sendVideoMessage(){
  const inp=document.getElementById('videoChatInput'); if(!inp) return; const t=inp.value.trim(); if(!t) return; videoMessages.push(`나: ${t}`); inp.value=''; post(selectedCaseId,'의견',`[영상 협진] ${t}`); renderVideoWorkspace(); const s=document.getElementById('videoChatStream'); if(s) s.scrollTop=s.scrollHeight;
}

const RARECROSS_EMBED_B64 = "";
let rareCrossLoaded = false;

function loadRareCross() {
  const frame = document.getElementById('rarecrossFrame');
  if (!frame || rareCrossLoaded) return;
  try {
    const bytes = Uint8Array.from(atob(RARECROSS_EMBED_B64), c => c.charCodeAt(0));
    const html = new TextDecoder('utf-8').decode(bytes);
    frame.srcdoc = html;
    rareCrossLoaded = true;
    frame.addEventListener('load', () => setTimeout(() => syncRareCrossCase(false), 120), {once:true});
  } catch (e) {
    console.warn('RareCross load failed', e);
    const ctx = document.getElementById('treatmentCaseContext');
    if (ctx) ctx.innerHTML = '<strong>도구 로드 실패 · </strong>브라우저 콘솔을 확인하세요.';
  }
}

function rareCrossCasePayload() {
  const c = getCase(selectedCaseId);
  if (!c) return null;
  const top = sortedCands(c)[0];
  return {
    id: c.id,
    title: c.title,
    age: c.age,
    sex: c.sex,
    status: c.status,
    finalDx: c.finalDx || '',
    leadingDx: top ? top.name : '',
    phenos: (c.phenos || []).map(p => p.t),
    owner: c.owner
  };
}

function renderTreatmentCaseContext() {
  const box = document.getElementById('treatmentCaseContext');
  if (!box) return;
  const c = getCase(selectedCaseId);
  if (!c) { box.innerHTML = '<strong>연결된 케이스 없음</strong>'; return; }
  const top = sortedCands(c)[0];
  box.innerHTML = `<strong>현재 연결 케이스 · </strong>${esc(c.id)} · ${esc(c.title)}<br><span style="color:var(--muted)">${esc(c.age)} ${esc(c.sex)} · 담당 ${esc(c.owner)}${top ? ` · 선두 후보 ${esc(top.name)}${top.sc.pct == null ? '' : ' ' + top.sc.pct + '%'}` : ''}</span>`;
}

function syncRareCrossCase(showNotice) {
  loadRareCross();
  renderTreatmentCaseContext();
  const frame = document.getElementById('rarecrossFrame');
  const payload = rareCrossCasePayload();
  if (!frame || !frame.contentWindow || !payload) return;
  frame.contentWindow.postMessage({type:'RARELINK_CASE_CONTEXT', payload}, '*');
  if (showNotice) toast(`${payload.id} 케이스를 치료 안전 도구에 연결했습니다`);
}

function reloadRareCross() {
  const frame = document.getElementById('rarecrossFrame');
  if (!frame) return;
  rareCrossLoaded = false;
  frame.removeAttribute('srcdoc');
  loadRareCross();
  toast('치료 안전 도구를 다시 불러왔습니다');
}

function openTreatmentForCase(caseId) {
  selectedCaseId = caseId;
  goTab('treatment');
  renderTreatmentCaseContext();
  setTimeout(() => syncRareCrossCase(false), 80);
}


window.addEventListener('message', (ev) => {
  const msg = ev.data || {};
  if (msg.type !== 'RARECROSS_HEIGHT') return;
  const frame = document.getElementById('rarecrossFrame');
  if (!frame || ev.source !== frame.contentWindow) return;
  const h = Math.max(420, Math.min(Number(msg.height) || 620, 2200));
  frame.style.height = h + 'px';
});

const _rarelinkGoTab = goTab;
goTab = function(tab) {
  _rarelinkGoTab(tab);
  if (tab === 'genetics') { renderGeneticsWorkspace(); }
  if (tab === 'video') { renderVideoWorkspace(); }
  if (tab === 'treatment') {
    renderTreatmentCaseContext();
    loadRareCross();
    setTimeout(() => syncRareCrossCase(false), 100);
  }
};

const _rarelinkSelectCase = selectCase;
selectCase = function(id) {
  _rarelinkSelectCase(id);
  renderTreatmentCaseContext();
  renderGeneticsWorkspace();
  renderVideoWorkspace();
  renderClinicalDashboard();
  if (rareCrossLoaded) setTimeout(() => syncRareCrossCase(false), 50);
};
</script>

