}

function renderBadge() {
  const mine = allConsults().filter(q => q.to === me.name && q.status === 'pending');
  const over = mine.filter(q => slaInfo(q).over).length;
  const b = document.getElementById('inboxBadge');
  b.textContent = `📨 받은 협진 요청 ${mine.length}건${over ? ` · 기한 초과 ${over}` : ''}`;
  b.classList.toggle('zero', !mine.length);
}

/* ---------- 협진 요청 카드 ---------- */
function consultCard(q, mode) {
  const c = getCase(q.caseId), s = slaInfo(q);
  const other = mode === 'in' ? q.from : q.to;
  const dir = mode === 'in' ? '보낸 의료진' : mode === 'out' ? '받는 의료진' : `${esc(q.from)} →`;
  const cls = q.status === 'replied' ? 'replied' : q.urgency === '긴급' ? 'urgent' : '';
  const btns = [];
  if (mode === 'in' && q.status === 'pending') btns.push(`<button class="btn btn-sm btn-primary" onclick="openReply('${q.id}')">회신하기</button>`);
  if (q.status === 'pending' && q.from === me.name && !isAccount(q.to) && person(q.to).demoReply) btns.push(`<button class="btn btn-sm btn-ghost" onclick="demoReply('${q.id}')">🎬 시연: 회신 도착</button>`);
  if (mode !== 'case') btns.push(`<button class="btn btn-sm" onclick="selectCase('${q.caseId}')">케이스 열기</button>`);
  return `<div class="consult ${cls}">
    <div class="consult-top"><span>${q.urgency === '긴급' ? '<span class="badge b-urgent">긴급</span> ' : ''}${dir} <b style="color:var(--text)">${esc(other)}</b> · ${esc(deptShort(other))} · ${esc(person(other).hospital || '')}</span><span class="sla ${s.over ? 'over' : ''}">${s.text}</span></div>
    ${mode !== 'case' && c ? `<div class="consult-q" style="margin-bottom:0"><b>${esc(c.id)}</b> ${esc(c.title)}</div>` : ''}
    <div class="consult-q">❓ ${esc(q.question)}</div>
    ${q.reply ? `<div class="consult-reply">💬 <b>${esc(q.to)}</b> 회신: ${esc(q.reply)}</div>` : ''}
    <div class="consult-top" style="margin-top:4px"><span>요청 ${esc(fmtDT(q.ts))}</span></div>
    ${btns.length ? `<div class="consult-actions">${btns.join('')}</div>` : ''}
  </div>`;
}

/* ---------- 탭 1: 내 협진 ---------- */
function renderHome() {
  const cons = allConsults(), cases = allCases();
  const inbox = cons.filter(q => q.to === me.name).sort((a, b) => (a.status === 'pending' ? 0 : 1) - (b.status === 'pending' ? 0 : 1) || b.ts - a.ts);
  const outbox = cons.filter(q => q.from === me.name);
  const pendingIn = inbox.filter(q => q.status === 'pending');
  const myCases = cases.filter(c => c.status !== 'done' && c.members.includes(me.name));
  const week = allMdts().filter(m => m.status === 'planned' && m.attendees.includes(me.name) && m.when - Date.now() < 7 * D);
  const overIn = pendingIn.filter(q => slaInfo(q).over).length;
  document.getElementById('homeStats').innerHTML = [
    ['회신 대기 중인 요청', pendingIn.length, overIn ? `<span style="color:var(--red);font-weight:800">기한 초과 ${overIn}건</span>` : '모두 기한 안', pendingIn.length ? 'var(--red)' : 'var(--text)'],
    ['내가 보낸 요청 (답변 대기)', outbox.filter(q => q.status === 'pending').length, `회신 완료 ${outbox.filter(q => q.status === 'replied').length}건`, 'var(--text)'],
    ['참여 중인 케이스', myCases.length, `의뢰 ${myCases.filter(c => c.owner === me.name).length} · 협진 참여 ${myCases.filter(c => c.owner !== me.name).length}`, 'var(--blue)'],
    ['7일 안 다학제 회의', week.length, week[0] ? `다음: ${fmtDT(week.sort((a, b) => a.when - b.when)[0].when)}` : '예정 없음', 'var(--purple)']
  ].map(([l, n, s, col]) => `<div class="stat"><div class="stat-label">${l}</div><div class="stat-num" style="color:${col}">${n}</div><div class="stat-sub">${s}</div></div>`).join('');

  document.getElementById('inboxList').innerHTML = inbox.length ? inbox.map(q => consultCard(q, 'in')).join('') : '<div class="empty">받은 협진 요청이 없습니다.</div>';
  document.getElementById('outboxList').innerHTML = outbox.length ? outbox.map(q => consultCard(q, 'out')).join('') : '<div class="empty">보낸 요청이 없습니다. 케이스 화면이나 전문가 찾기에서 요청할 수 있습니다.</div>';

  const up = allMdts().filter(m => m.status === 'planned' && m.attendees.includes(me.name)).sort((a, b) => a.when - b.when);
  document.getElementById('homeMdt').innerHTML = up.length ? up.map(m => `<div class="agenda-item"><b>${esc(fmtDT(m.when))}</b> · ${esc(m.title)}<br><span class="note" style="margin:0">${esc(m.mode)} · 안건 ${m.caseIds.length}건 · 참석 ${m.attendees.length}명</span> <button class="link-btn" onclick="goTab('mdt')">회의 보기 →</button></div>`).join('<div style="height:6px"></div>') : '<div class="empty">예정된 회의가 없습니다.</div>';

  const acts = [];
  cases.filter(c => c.status !== 'done').forEach(c => c.actions.filter(a => a.owner === me.name && !a.done).forEach(a => acts.push({a, c})));
  acts.sort((x, y) => (x.a.due || 0) - (y.a.due || 0));
  document.getElementById('homeActions').innerHTML = acts.length ? acts.map(({a, c}) => actionRow(a, c)).join('') : '<div class="empty">배정된 할 일이 없습니다.</div>';

  const feed = [];
  cases.filter(c => c.members.includes(me.name)).forEach(c => c.thread.forEach(p => feed.push({p, c})));
  feed.sort((x, y) => y.p.ts - x.p.ts);
  document.getElementById('homeFeed').innerHTML = feed.length ? feed.slice(0, 7).map(({p, c}) => `<div class="post" style="margin-top:8px;cursor:pointer" onclick="selectCase('${c.id}')">${avatar(p.by)}<div class="post-body"><div class="post-top"><b>${esc(p.by)}</b> ${esc(deptShort(p.by))} · <span class="tag tag-${esc(p.tag)}">${esc(p.tag === '검사' ? '검사 결과' : p.tag)}</span> · ${esc(c.id)} · ${ago(p.ts)}</div><div class="post-text">${fmtText(p.text.length > 110 ? p.text.slice(0, 110) + '…' : p.text)}</div></div></div>`).join('') : '<div class="empty">아직 활동이 없습니다.</div>';
}

/* ---------- 탭 2: 케이스 목록 ---------- */
function renderCaseList() {
  const filters = [['active', '진행 중'], ['mine', '내 참여'], ['mdt', '회의 예정'], ['done', '확진'], ['all', '전체']];
  document.getElementById('caseFilters').innerHTML = filters.map(([k, l]) => `<button class="filter-btn ${caseFilter === k ? 'on' : ''}" onclick="caseFilter='${k}';renderCaseList()">${l}</button>`).join('');
  const q = (document.getElementById('caseSearch').value || '').trim();
  let list = allCases();
  if (caseFilter === 'active') list = list.filter(c => c.status !== 'done');
  if (caseFilter === 'mine') list = list.filter(c => c.members.includes(me.name));
  if (caseFilter === 'mdt') list = list.filter(c => c.status === 'mdt');
  if (caseFilter === 'done') list = list.filter(c => c.status === 'done');
  if (q) list = list.filter(c => [c.id, c.title, c.summary, c.finalDx, ...c.phenos.map(p => p.t), ...c.cands.map(cd => cd.name)].join(' ').includes(q));
  list.sort((a, b) => (a.status === 'done') - (b.status === 'done') || (b.urgency === '긴급') - (a.urgency === '긴급') || b.createdAt - a.createdAt);
  document.getElementById('caseList').innerHTML = list.length ? list.map(c => {
    const top = sortedCands(c)[0];
    return `<button class="case-item ${c.id === selectedCaseId ? 'active' : ''} ${c.urgency === '긴급' && c.status !== 'done' ? 'urgent' : ''}" onclick="selectCase('${c.id}')">
      <div class="ci-top"><span>${esc(c.id)} · ${ago(c.createdAt)}</span><span><span class="badge ${STATUS_CLS[c.status]}">${STATUS_LABEL[c.status]}</span>${c.urgency === '긴급' && c.status !== 'done' ? ' <span class="badge b-urgent">긴급</span>' : ''}</span></div>
      <div class="ci-title">${esc(c.title)}</div>
      <div class="ci-meta">${esc(c.age)} ${esc(c.sex)} · ${esc(deptShort(c.owner))} · 의료진 ${c.members.length}명</div>
      <div class="ci-meta" style="margin-top:3px">${c.status === 'done' ? `✅ ${esc(c.finalDx)}` : top && top.sc.pct != null ? `선두 후보: <b style="color:${pctColor(top.sc.pct)}">${esc(top.name)} ${top.sc.pct}%</b>` : '후보 진단 없음'}</div>
    </button>`;
  }).join('') : '<div class="empty">조건에 맞는 케이스가 없습니다.</div>';
}

/* ---------- 탭 2: 케이스 상세 ---------- */
function fmtText(t) {
  return esc(t).replace(/@([가-힣]{2,4})/g, (m, n) => EXPERTS.some(e => e.name === n) ? `<span class="mention">@${n}</span>` : m);
}
function phenoChip(p, c) {
  const cat = TERM_CAT[p.t], col = cat ? CAT_COLOR[cat] : '#94a3b8';
  const removable = !p.seed && p.by === me.name && c.status !== 'done';
  return `<span class="chip" title="${cat ? esc(cat) : '비표준 용어 — 매칭에 쓰이지 않음'} · 추가: ${esc(p.by)}"><span class="dot" style="background:${col}"></span>${esc(p.t)}${cat ? '' : ' <small style="color:var(--muted)">(비표준)</small>'}${removable ? `<button class="x" aria-label="${esc(p.t)} 삭제" onclick="removePheno('${p.id}')">×</button>` : ''}</span>`;
}
function actionRow(a, c) {
  const late = !a.done && a.due && a.due < Date.now();
  return `<div class="action ${a.done ? 'done' : ''}"><input type="checkbox" ${a.done ? 'checked' : ''} ${c.status === 'done' ? 'disabled' : ''} aria-label="완료" onchange="toggleAction('${c.id}','${a.id}',this.checked)" /><div><div class="action-text">${esc(a.text)}</div><div class="action-meta">${esc(c.id)} · 담당 <b>${esc(a.owner)}</b> (${esc(deptShort(a.owner))})${a.due ? ` · <span class="${late ? 'late' : ''}">기한 ${fmtDate(a.due)}${late ? ' 지남' : ''}</span>` : ''}${a.done && a.doneBy ? ` · 완료 ${esc(a.doneBy)}` : ''}</div></div></div>`;
}

function renderCaseDetail() {
  const c = getCase(selectedCaseId);
  const wrap = document.getElementById('caseDetail');
  if (!c) { wrap.style.display = 'none'; return; }
  wrap.style.display = '';
  const done = c.status === 'done', owner = person(c.owner);
  const years = odysseyYears(c);

  document.getElementById('cdHead').innerHTML = `
    <div class="case-head"><div style="flex:1;min-width:260px">
      <div class="row"><span class="badge">${esc(c.id)}</span><span class="badge ${STATUS_CLS[c.status]}">${STATUS_LABEL[c.status]}</span>${c.urgency === '긴급' && !done ? '<span class="badge b-urgent">긴급</span>' : ''}<span class="badge b-lock" title="이름·등록번호 등 식별정보 없이 공유됩니다">🔒 비식별 공유</span></div>
      <h2>${esc(c.title)}</h2>
      <div class="case-meta"><span>👤 ${esc(c.age)} · ${esc(c.sex)}</span><span>🏥 의뢰 ${esc(c.owner)} (${esc(owner.dept)}, ${esc(owner.hospital)})</span><span>📅 등록 ${fmtDate(c.createdAt)}</span></div>
      <div class="case-meta" style="margin-top:4px"><span>👥 참여 의료진 ${c.members.length}명: ${c.members.map(n => `${esc(n)}<small>(${esc(deptShort(n))})</small>`).join(', ')}</span></div>
    </div>
    <div class="row">
      ${!done ? `<button class="btn btn-primary" onclick="openConsult(null,'${c.id}')">📨 협진 요청</button><button class="btn" onclick="openMdtForm('${c.id}')">📅 회의 안건으로</button><button class="btn" onclick="openGeneticsForCase('${c.id}')">🧬 유전체·가계도</button><button class="btn" onclick="openVideoForCase('${c.id}')">🎥 영상 협진</button><button class="btn" onclick="openTreatmentForCase('${c.id}')">🩺 치료 안전 검토</button><button class="btn btn-success" onclick="openClose()">✔ 최종 진단 확정</button>` : (c.owner === me.name ? `<button class="btn" onclick="reopenCase()">↺ 진행 중으로 되돌리기</button>` : '')}
    </div></div>
    ${c.summary ? `<p style="font-size:13px;line-height:1.7;margin:12px 0 0">${esc(c.summary)}</p>` : ''}
    <div class="question-box"><strong>협진 질문 · </strong>${esc(c.question)}</div>
    <div class="odyssey">
      <div>증상 시작<b>${c.onsetYear}년</b></div>
      <div>${done ? '확진까지' : '진단 방랑'}<b>${years}년${done ? '' : '째'}</b></div>
      <div>거쳐 간 기관·진료과<b>${c.journey.length}곳</b></div>
      <div>배제된 진단<b>${c.excluded.length}개</b></div>
      <div>협진 등록 후<b>${Math.max(0, Math.floor(((done && c.closedAt ? c.closedAt : Date.now()) - c.createdAt) / D))}일</b></div>
    </div>
    ${done ? `<div class="question-box" style="background:color-mix(in srgb,var(--green) 9%,var(--panel));border-color:var(--green)"><strong style="color:var(--green)">✅ 최종 진단 · </strong><b>${esc(c.finalDx)}</b><br><b>핵심 단서</b> ${esc(c.clue || '-')}<br><b>다음 케이스를 위한 교훈</b> ${esc(c.lesson || '-')}</div>` : ''}`;

  document.getElementById('cdPhenos').innerHTML = c.phenos.length ? c.phenos.map(p => phenoChip(p, c)).join('') : '<div class="empty" style="width:100%">등록된 증상이 없습니다.</div>';
  document.getElementById('cdOdysseyNote').textContent = done ? `증상 시작 ${years}년 만에 확진` : `증상 시작 ${years}년째 진단 미확정`;
  document.getElementById('cdJourney').innerHTML = c.journey.length ? `<div class="tl">${c.journey.map((j, i) => `<div class="tl-item ${i === c.journey.length - 1 ? 'now' : ''}"><div class="tl-date">${esc(j[0])}</div><div class="tl-where">${esc(j[1])}</div><div class="tl-what">${esc(j[2])}</div></div>`).join('')}</div>` : '<div class="empty">기록된 여정이 없습니다.</div>';
  document.getElementById('cdExcluded').innerHTML = c.excluded.length ? c.excluded.map(e => `<div class="ex-item"><s>${esc(e[0])}</s><span>${esc(e[1])}</span></div>`).join('') : '<div class="empty">없음</div>';
  document.getElementById('cdTests').innerHTML = c.tests.length ? `<table class="kv">${c.tests.map(t => `<tr><td>${esc(t[0])}</td><td>${esc(t[1])}</td></tr>`).join('')}</table>` : '<div class="empty">없음</div>';

  /* 감별진단 보드 */
  const cands = sortedCands(c);
  document.getElementById('cdCands').innerHTML = cands.length ? cands.map((cd, i) => {
    const sc = cd.sc, myv = cd.votes[me.name];
    const votes = Object.entries(cd.votes).sort((a, b) => a[1].ts - b[1].ts);
    return `<div class="cand ${i === 0 && sc.pct != null ? 'top' : ''}">
      <div class="cand-head"><div><div class="cand-name">${esc(cd.name)}${agreeTag(sc.agree)}</div><div class="cand-by">제안 ${esc(cd.by)} · ${esc(deptShort(cd.by))} · ${ago(cd.ts)}</div></div>
      <div class="cand-pct" style="color:${pctColor(sc.pct)}">${sc.pct == null ? '–' : sc.pct + '%'}<small>합의 가능성 · ${sc.n}명</small></div></div>
      <div class="bar"><div style="width:${sc.pct || 0}%;background:${pctColor(sc.pct)}"></div></div>
      <div class="votes">${votes.length ? votes.map(([n, v]) => `<div class="vote"><span class="lv lv-${v.level}">${LV[v.level]}</span> · <b>${esc(n)}</b> <span style="color:var(--muted)">${esc(deptShort(n))}</span>${v.note ? ` — ${esc(v.note)}` : ''}</div>`).join('') : '<div class="vote" style="color:var(--muted)">아직 판단한 의료진이 없습니다.</div>'}</div>
      ${cd.nextTest ? `<div class="next-test">🧪 확인 검사: ${esc(cd.nextTest)}</div>` : ''}
      ${!done ? `<div class="my-vote">내 판단: ${[3, 2, 1, 0].map(l => `<button class="vbtn ${myv && myv.level === l ? 'on' : ''}" onclick="openVote('${cd.key}',${l})">${LV[l]}</button>`).join('')}${myv ? ` <button class="link-btn" onclick="withdrawVote('${cd.key}')">철회</button>` : ''}</div>` : ''}
    </div>`;
  }).join('') : '<div class="empty">후보 진단이 없습니다. 아래에서 추가하거나 매칭 결과에서 가져오세요.</div>';
  document.getElementById('candName').disabled = document.getElementById('candTest').disabled = done;

  /* 매칭 */
  const ms = matchDiseases(c.phenos.map(p => p.t));
  const sims = similarCases(c);
  document.getElementById('cdMatch').innerHTML = (ms.length ? ms.map(m => {
    const exists = c.cands.some(cd => cd.name.replace(/\s/g, '').includes(m.d.name.split(' (')[0].replace(/\s/g, '')));
    return `<div class="match">
      <div class="match-head"><div><span class="match-name">${esc(m.d.name)}</span> <span class="match-sub">${esc(m.d.en)} · ${esc(m.d.inherit)}</span></div><span class="match-score" style="color:${pctColor(m.score)}">${m.score}%</span></div>
      <div class="bar" style="margin:6px 0"><div style="width:${m.score}%;background:${pctColor(m.score)}"></div></div>
      <div class="chips">${m.hit.map(t => `<span class="chip hit">✓ ${esc(t)}</span>`).join('')}${m.missingCore.map(t => `<span class="chip miss">? ${esc(t)}</span>`).join('')}</div>
      ${m.missingCore.length ? `<div class="check-hint">🔍 <b>확인하면 판단이 선명해지는 핵심 소견</b> — ${m.missingCore.map(t => `${esc(t)} → ${esc(CHECK_HOW[t] || '추가 병력·진찰')}`).join(' · ')}</div>` : ''}
      <div class="check-hint">🧪 확진 검사: ${esc(m.d.test)}</div>
      <div class="row" style="margin-top:6px">${!done ? `<button class="btn btn-sm" ${exists ? 'disabled' : ''} onclick="addCandidateFromKb('${m.d.id}')">${exists ? '보드에 있음' : '감별진단에 추가'}</button>` : ''}<button class="btn btn-sm btn-ghost" onclick="expertsFor('${c.id}')">관련 전문가 보기</button></div>
    </div>`;
  }).join('') : '<div class="empty">표준 증상 용어를 추가하면 후보 질환이 표시됩니다.</div>')
  + (sims.length ? `<div class="similar"><b>📚 비슷한 과거 확진 케이스</b>${sims.map(s => `<div style="margin-top:6px"><button class="link-btn" style="font-size:12px" onclick="selectCase('${s.x.id}')">${esc(s.x.id)} · ${esc(s.x.finalDx)}</button><br><span style="color:var(--muted)">공통 증상: ${s.common.map(esc).join(', ')}</span><br>💡 ${esc(s.x.clue)}</div>`).join('')}</div>` : '')
  + '<p class="note">증상 겹침으로 계산한 참고 정보이며 진단이 아닙니다. 실제 서비스에서는 HPO 표준 용어와 Orphanet 같은 희귀질환 데이터베이스와 연결합니다.</p>';

  /* 토론 */
  const th = document.getElementById('cdThread');
  const atBottom = th.scrollHeight - th.scrollTop - th.clientHeight < 30 || th.dataset.caseId !== c.id;
  th.innerHTML = c.thread.length ? c.thread.map(p => `<div class="post ${p.tag === '요청' ? 'sys' : ''}">${avatar(p.by)}<div class="post-body"><div class="post-top"><b>${esc(p.by)}</b> ${esc(person(p.by).dept)} · <span class="tag tag-${esc(p.tag)}">${esc(p.tag === '검사' ? '검사 결과' : p.tag)}</span> · <span title="${esc(fmtDT(p.ts))}">${esc(fmtDT(p.ts))}</span></div><div class="post-text">${fmtText(p.text)}</div></div></div>`).join('') : '<div class="empty">첫 의견을 남겨 주세요.</div>';
  if (atBottom) th.scrollTop = th.scrollHeight;
  th.dataset.caseId = c.id;
  ['postText', 'postTag'].forEach(id => { document.getElementById(id).disabled = done; });

  document.getElementById('cdConsults').innerHTML = c.consults.length ? c.consults.map(q => consultCard(q, 'case')).join('') : '<div class="empty">아직 보낸 요청이 없습니다.</div>';

  document.getElementById('cdActions').innerHTML = c.actions.length ? c.actions.slice().sort((a, b) => (a.done ? 1 : 0) - (b.done ? 1 : 0) || (a.due || 0) - (b.due || 0)).map(a => actionRow(a, c)).join('') : '<div class="empty">등록된 할 일이 없습니다.</div>';
  const sel = document.getElementById('actOwner'), keep = sel.value;
  const owners = [...new Set([me.name, ...c.members])];
  sel.innerHTML = owners.map(n => `<option value="${esc(n)}">${esc(n)} (${esc(deptShort(n))})</option>`).join('');
  if (owners.includes(keep)) sel.value = keep;
}

/* ---------- 탭 3: 전문가 ---------- */
function expertsFor(caseId) {
  document.getElementById('expertCase').value = caseId;
  goTab('experts');
  renderExperts();
}
function renderExperts() {
  const sel = document.getElementById('expertCase'), keep = sel.value;
  const active = allCases().filter(c => c.status !== 'done');
  sel.innerHTML = `<option value="">케이스 기준 추천 안 함</option>` + active.map(c => `<option value="${c.id}">${esc(c.id)} · ${esc(c.title.slice(0, 22))}…</option>`).join('');
  sel.value = active.some(c => c.id === keep) ? keep : '';
  const q = (document.getElementById('expertSearch').value || '').trim();
  const c = sel.value ? getCase(sel.value) : null;

  let list = EXPERTS.map(e => {
    let score = 0; const why = [];
    if (c) {
      const strong = matchDiseases(c.phenos.map(p => p.t)).filter(m => m.score >= 30).slice(0, 3);
      const names = [...c.cands.map(cd => cd.name), ...strong.map(m => m.d.name.split(' (')[0])];
      const hitDx = e.focus.filter(f => names.some(n => n.includes(f) || f.includes(n.split(' (')[0])));
      if (hitDx.length) { score += 3 * hitDx.length; why.push(`후보 질환 전문: ${hitDx.join(', ')}`); }
      const hitSx = e.focus.filter(f => c.phenos.some(p => p.t.includes(f) || f.includes(p.t)));
      if (hitSx.length) { score += 2 * hitSx.length; why.push(`증상 관련: ${hitSx.join(', ')}`); }
      const need = [...new Set(strong.flatMap(m => m.missingCore))].filter(t => e.focus.includes(t));
      if (need.length) { score += 2 * need.length; why.push(`확인 필요 소견 담당: ${need.join(', ')}`); }
      if (e.focus.includes('변이 해석') && c.cands.some(cd => /유전자|패널|변이/.test(cd.nextTest || ''))) { score += 3; why.push('후보 확인에 유전자 검사 필요 — 변이 해석'); }
      const needDept = strong.flatMap(m => m.d.depts);
      if (needDept.some(d => e.dept.includes(d))) { score += 1; if (!why.length) why.push('매칭 질환 관련 진료과'); }
    }
    return {e, score, why, member: c ? c.members.includes(e.name) : false};
  });
  if (q) list = list.filter(({e}) => [e.name, e.dept, e.hospital, e.region, ...e.focus].join(' ').includes(q));
  const rank = x => (x.member || x.e.name === me.name) ? x.score - 100 : x.score;
  list.sort((a, b) => rank(b) - rank(a) || b.e.rate - a.e.rate);
  document.getElementById('expertNote').textContent = c ? `${c.id} 케이스의 후보 질환·증상과 전문 분야가 겹치는 순서로 추천합니다. 보라색 테두리가 추천 전문가입니다.` : '케이스를 고르면 그 케이스에 맞는 전문가를 추천합니다.';
  const AV = {on: ['on', '● 회신 가능'], busy: ['busy', '● 외래 진료 중'], off: ['off', '● 부재 (학회)']};
  document.getElementById('expertList').innerHTML = list.length ? list.map(({e, score, why, member}) => `<div class="expert ${score >= 3 && !member && e.name !== me.name ? 'rec' : ''}">
      <div class="expert-top">${avatar(e.name)}<div style="flex:1"><div class="expert-name">${esc(e.name)}${e.name === me.name ? ' <span class="badge">나</span>' : ''}${member ? ' <span class="badge b-open">참여 중</span>' : ''}</div><div class="expert-dept">${esc(e.dept)} · ${esc(e.hospital)} (${esc(e.region)})</div></div><span class="avail ${AV[e.status][0]}">${AV[e.status][1]}</span></div>
      ${why.length ? `<div class="rec-why">✨ ${esc(why.join(' · '))}</div>` : ''}
      <div class="chips">${e.focus.map(f => `<span class="chip">${esc(f)}</span>`).join('')}</div>
      <div class="expert-stats"><div><b>${e.cases}</b>협진 참여</div><div><b>${e.replyH}시간</b>평균 회신</div><div><b>${e.rate}%</b>기한 내 회신</div></div>
      ${e.name !== me.name ? `<button class="btn btn-primary" onclick="openConsult('${e.name}', document.getElementById('expertCase').value || null)">📨 협진 요청</button>` : ''}
    </div>`).join('') : '<div class="empty">검색 결과가 없습니다.</div>';
}

/* ---------- 탭 4: 다학제 회의 ---------- */
function renderMdt() {
  const ms = allMdts();
  const planned = ms.filter(m => m.status === 'planned').sort((a, b) => a.when - b.when);
  const done = ms.filter(m => m.status === 'done').sort((a, b) => b.when - a.when);
  const card = m => {
    const dday = Math.ceil((new Date(m.when).setHours(0, 0, 0, 0) - new Date().setHours(0, 0, 0, 0)) / D);
    return `<div class="mdt ${m.status === 'done' ? 'done' : ''}">
      <div class="row" style="justify-content:space-between"><div><span class="mdt-when">${esc(fmtDT(m.when))}</span> ${m.status === 'planned' ? `<span class="badge b-mdt">${dday <= 0 ? '오늘' : 'D-' + dday}</span>` : '<span class="badge b-done">회의 완료</span>'} <b style="margin-left:4px">${esc(m.title)}</b></div>
      <div class="row">${m.status === 'planned' ? `<button class="btn btn-sm btn-primary" onclick="openMdtRun('${m.id}')">▶ 회의 진행 · 결론 기록</button>` : ''}</div></div>
      <div class="note" style="margin-top:4px">${esc(m.mode)} · 주최 ${esc(m.createdBy)} · 참석 ${m.attendees.map(n => `${esc(n)}(${esc(deptShort(n))})`).join(', ')}</div>
      <div class="agenda">${m.caseIds.map(id => {
        const c = getCase(id); if (!c) return '';
        const top = sortedCands(c)[0], open = c.actions.filter(a => !a.done).length;
        const concl = m.conclusions && m.conclusions[id];
        return `<div class="agenda-item"><button class="link-btn" style="font-size:12px" onclick="selectCase('${id}')">${esc(id)}</button> ${esc(c.title)}<br><span style="color:var(--muted)">${top && top.sc.pct != null ? `선두 후보 ${esc(top.name)} ${top.sc.pct}%` : '후보 없음'}${top ? ' ' + agreeTag(top.sc.agree) : ''} · 남은 할 일 ${open}건</span>${concl ? `<div class="conclusion">📝 결론: ${esc(concl)}</div>` : ''}</div>`;
      }).join('')}</div>
    </div>`;
  };
  document.getElementById('mdtList').innerHTML = (planned.length ? '<h4 style="margin-top:14px">예정된 회의</h4>' + planned.map(card).join('') : '<div class="empty" style="margin-top:12px">예정된 회의가 없습니다.</div>') + (done.length ? '<h4 style="margin-top:20px">지난 회의</h4>' + done.map(card).join('') : '');
}

/* ---------- 탭 5: 라이브러리 ---------- */
function renderLibrary() {
  const all = allCases().filter(c => c.status === 'done');
  const avgYears = all.length ? (all.reduce((a, c) => a + odysseyYears(c), 0) / all.length).toFixed(1) : '-';
  const avgDays = all.length ? Math.round(all.reduce((a, c) => a + ((c.closedAt || Date.now()) - c.createdAt) / D, 0) / all.length) : '-';
  const avgDepts = all.length ? (all.reduce((a, c) => a + (c.depts || []).length, 0) / all.length).toFixed(1) : '-';
  document.getElementById('libStats').innerHTML = [
    ['확진 케이스', all.length, '협진으로 진단이 확정된 케이스', 'var(--green)'],
    ['평균 진단 방랑 기간', avgYears + '년', '증상 시작 → 확진', 'var(--red)'],
    ['협진 등록 후 확진까지', avgDays + '일', 'RareLink 등록 → 최종 진단', 'var(--blue)'],
    ['케이스당 참여 진료과', avgDepts + '개', '다학제 협진 폭', 'var(--purple)']
  ].map(([l, n, s, col]) => `<div class="stat"><div class="stat-label">${l}</div><div class="stat-num" style="color:${col}">${n}</div><div class="stat-sub">${s}</div></div>`).join('');
  const q = (document.getElementById('libSearch').value || '').trim();
  const list = all.filter(c => !q || [c.finalDx, c.title, c.clue, c.lesson, ...c.phenos.map(p => p.t)].join(' ').includes(q)).sort((a, b) => (b.closedAt || 0) - (a.closedAt || 0));
  document.getElementById('libList').innerHTML = list.length ? list.map(c => `<div class="lib-card">
      <div class="row" style="justify-content:space-between"><span class="badge">${esc(c.id)}</span><span class="note" style="margin:0">확진 ${c.closedAt ? fmtDate(c.closedAt) : '-'}</span></div>
      <div class="lib-dx">${esc(c.finalDx)}</div>
      <div style="font-size:12px;font-weight:700">${esc(c.title)}</div>
      <div class="note" style="margin-top:2px">${esc(c.age)} ${esc(c.sex)} · 증상 시작 ${odysseyYears(c)}년 만에 확진 · 협진 등록 후 ${Math.round(((c.closedAt || Date.now()) - c.createdAt) / D)}일</div>
      <div class="chips" style="margin-top:8px">${c.phenos.map(p => phenoChip({...p, seed: true}, c)).join('')}</div>
      <div class="lib-row"><b>💡 핵심 단서</b>${esc(c.clue || '-')}</div>
      <div class="lib-row"><b>📌 교훈</b>${esc(c.lesson || '-')}</div>
      <div class="lib-row"><b>👥 참여 진료과</b>${esc((c.depts || []).join(', '))}</div>
      <button class="btn btn-sm" style="margin-top:10px" onclick="selectCase('${c.id}')">케이스 보기</button>
    </div>`).join('') : '<div class="empty">확진된 케이스가 없습니다.</div>';
}

/* ---------- 탭 6: 열람 기록 ---------- */
function renderAudit() {
  const rows = auditLog.slice().sort((a, b) => b.ts - a.ts).slice(0, 300);
  document.getElementById('auditBody').innerHTML = rows.length ? rows.map(l => `<tr><td style="white-space:nowrap">${esc(fmtDT(l.ts))}</td><td>${esc(l.user)}</td><td>${esc(l.kind)}</td><td>${esc(l.text)}</td></tr>`).join('') : '<tr><td colspan="4" style="text-align:center;color:var(--muted)">기록이 없습니다.</td></tr>';
}
</script>
<script>
/* =====================================================================
   동작 · 모달
   ===================================================================== */
function openModal(html) { document.getElementById('modalBox').innerHTML = html; document.getElementById('modal').classList.add('show'); const f = document.querySelector('#modalBox [autofocus]'); if (f) f.focus(); }
function closeModal() { document.getElementById('modal').classList.remove('show'); }
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
function modalHead(title) { return `<div class="modal-head"><h3>${title}</h3><button class="btn btn-sm" onclick="closeModal()" aria-label="닫기">✕</button></div>`; }
function post(caseId, tag, text, by) { put(`thread/${caseId}/${uid()}`, {by: by || me.name, tag, text, ts: Date.now()}); }

/* ---------- 증상 ---------- */
function addPheno() {
  const inp = document.getElementById('phenoInput'), t = inp.value.trim();
  const c = getCase(selectedCaseId);
  if (!t || !c) return;
  if (c.phenos.some(p => p.t === t)) { toast('이미 있는 증상입니다'); return; }
  put(`phenos/${c.id}/${uid()}`, {t, by: me.name, ts: Date.now()});
  log('수정', `${c.id} 증상 추가: ${t}`);
  if (!TERM_CAT[t]) toast('표준 용어가 아니어서 매칭에는 쓰이지 않습니다');
  inp.value = '';
}
function removePheno(id) {
  const c = getCase(selectedCaseId), p = c.phenos.find(x => x.id === id);
  if (!p) return;
  put(`phenos/${c.id}/${id}`, null);
  log('수정', `${c.id} 증상 삭제: ${p.t}`);
}

/* ---------- 감별진단 ---------- */
function addCandidate(name, nextTest) {
  const c = getCase(selectedCaseId);
  name = (name || document.getElementById('candName').value).trim();
  nextTest = (nextTest != null ? nextTest : document.getElementById('candTest').value).trim();
  if (!name) { document.getElementById('candName').focus(); return; }
  if (c.cands.some(cd => cd.name === name)) { toast('이미 보드에 있는 후보입니다'); return; }
  const key = uid();
  put(`cands/${c.id}/${key}`, {name, nextTest, by: me.name, ts: Date.now()});
  log('수정', `${c.id} 후보 진단 추가: ${name}`);
  document.getElementById('candName').value = ''; document.getElementById('candTest').value = '';
  openVote(key, 2);
}
function addCandidateFromKb(id) { const d = KB.find(x => x.id === id); addCandidate(d.name, d.test); }

function openVote(key, level) {
  const c = getCase(selectedCaseId), cd = c.cands.find(x => x.key === key);
  if (!cd) return;
  const mine = cd.votes[me.name];
  openModal(`${modalHead('🧩 가능성 판단 남기기')}
    <p class="note" style="margin-top:0">${esc(c.id)} · <b style="color:var(--text)">${esc(cd.name)}</b></p>
    <label class="form-label">가능성</label>
    <div class="row" id="voteLevels">${[3, 2, 1, 0].map(l => `<button class="vbtn ${l === level ? 'on' : ''}" data-l="${l}" onclick="document.querySelectorAll('#voteLevels .vbtn').forEach(b=>b.classList.toggle('on', b===this))">${LV[l]}</button>`).join('')}</div>
    <label class="form-label" for="voteNote">근거 <span style="color:var(--red)">*</span></label>
    <textarea id="voteNote" class="field" autofocus placeholder="어떤 소견 때문에 이렇게 판단했는지 (다른 진료과가 이해할 수 있게)">${esc(mine ? mine.note : '')}</textarea>
    <p class="note">근거가 함께 남아야 다른 진료과가 판단을 검토하고 토론할 수 있습니다.</p>
    <div class="form-error" id="voteErr"></div>
    <div class="modal-foot"><button class="btn" onclick="closeModal()">취소</button><button class="btn btn-primary" onclick="saveVote('${key}')">저장</button></div>`);
}
function saveVote(key) {
  const c = getCase(selectedCaseId), cd = c.cands.find(x => x.key === key);
  const on = document.querySelector('#voteLevels .vbtn.on'), note = document.getElementById('voteNote').value.trim();
  if (!note) { document.getElementById('voteErr').textContent = '판단 근거를 입력하세요.'; return; }
  const level = Number(on.dataset.l);
  put(`votes/${c.id}/${key}/${me.name}`, {level, note, ts: Date.now()});
  log('수정', `${c.id} ${cd.name} 판단: ${LV[level]}`);
  closeModal();
}
function withdrawVote(key) {
  const c = getCase(selectedCaseId), cd = c.cands.find(x => x.key === key);
  if (!confirm(`'${cd.name}'에 대한 내 판단을 철회할까요?`)) return;
  put(`votes/${c.id}/${key}/${me.name}`, {level: -1, ts: Date.now()});
  log('수정', `${c.id} ${cd.name} 판단 철회`);
}

/* ---------- 토론 ---------- */
function addPost() {
  const ta = document.getElementById('postText'), text = ta.value.trim();
  if (!text) { ta.focus(); return; }
  const c = getCase(selectedCaseId), tag = document.getElementById('postTag').value;
  post(c.id, tag, text);
  log('작성', `${c.id} 토론 글 (${tag})`);
  const mentioned = [...text.matchAll(/@([가-힣]{2,4})/g)].map(m => m[1]).filter(n => EXPERTS.some(e => e.name === n));
